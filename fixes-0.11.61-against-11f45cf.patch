diff --git a/Cmake/SohExtremeAPCppIdentity.cmake b/Cmake/SohExtremeAPCppIdentity.cmake
new file mode 100644
--- /dev/null
+++ b/Cmake/SohExtremeAPCppIdentity.cmake
@@ -0,0 +1,55 @@
+# Publish server-authenticated room identity on the network thread, before slot
+# data. This avoids reading mutable APCpp strings from the gameplay thread.
+include_guard(GLOBAL)
+function(soh_extreme_ap_identity source_dir)
+    file(LOCK "${source_dir}/.soh-extreme-identity.lock" GUARD FUNCTION TIMEOUT 120)
+    file(READ "${source_dir}/Archipelago.cpp" cpp)
+    string(REPLACE "\r\n" "\n" cpp "${cpp}")
+    set(old [=[            ap_player_team = root[i]["team"].asInt();]=])
+    set(new [=[            ap_player_team = root[i]["team"].asInt();
+            // SOH-EXTREME connection identity 0.11.61: this is local metadata,
+            // derived from RoomInfo/Connected, never a supplied slot_data value.
+            const auto identityCallback = map_slotdata_callback_raw.find("_soh_connection_identity");
+            if (identityCallback != map_slotdata_callback_raw.end()) {
+                Json::Value identity;
+                identity["seed"] = lib_room_info.seed_name;
+                identity["team"] = ap_player_team;
+                identity["slot"] = ap_player_id;
+                identity["name"] = ap_player_name;
+                identityCallback->second(writer.write(identity));
+            }]=])
+    set(old_key [=[                std::string key = slot_itr.key().asString();]=])
+    set(new_key [=[                std::string key = slot_itr.key().asString();
+                if (key == "_soh_connection_identity") continue; // local-only callback]=])
+    foreach(pair IN ITEMS identity key)
+        if(pair STREQUAL "identity")
+            set(before "${old}")
+            set(after "${new}")
+        else()
+            set(before "${old_key}")
+            set(after "${new_key}")
+        endif()
+        string(FIND "${cpp}" "${after}" fixed)
+        if(fixed EQUAL -1)
+            string(FIND "${cpp}" "SOH-EXTREME connection identity 0.11.61" marker)
+            if(pair STREQUAL "identity" AND NOT marker EQUAL -1)
+                message(FATAL_ERROR "SOH-EXTREME: changed APCpp identity patch; nothing overwritten.")
+            endif()
+            string(FIND "${cpp}" "${before}" found)
+            if(found EQUAL -1)
+                message(FATAL_ERROR "SOH-EXTREME: APCpp identity anchor missing; nothing overwritten.")
+            endif()
+            string(REPLACE "${before}" "" stripped "${cpp}")
+            string(LENGTH "${cpp}" full_len)
+            string(LENGTH "${stripped}" stripped_len)
+            string(LENGTH "${before}" anchor_len)
+            math(EXPR removed "${full_len} - ${stripped_len}")
+            if(NOT removed EQUAL anchor_len)
+                message(FATAL_ERROR "SOH-EXTREME: duplicate APCpp identity anchor; nothing overwritten.")
+            endif()
+            string(REPLACE "${before}" "${after}" cpp "${cpp}")
+        endif()
+    endforeach()
+    file(WRITE "${source_dir}/Archipelago.cpp" "${cpp}")
+endfunction()
+soh_extreme_ap_identity("${apcpp_SOURCE_DIR}")
diff --git a/SOH_AP_FIX_HISTORY.txt b/SOH_AP_FIX_HISTORY.txt
--- a/SOH_AP_FIX_HISTORY.txt
+++ b/SOH_AP_FIX_HISTORY.txt
@@ -1,3 +1,24 @@
+0.11.61 - Reconnect saved AP games after an address/port change (2026-10-08)
+  - Save metadata now records AP seed name, team and slot ID separately from
+    the connection address. The same game can move to a new port or host.
+  - The updated APCpp DLL publishes authenticated connection metadata through
+    the existing callback queue. The game does not read network-owned strings.
+  - Existing saves always restore their own cached AP settings before scene
+    actors initialize, even offline or when a mismatching room is configured.
+    Unverified live settings cannot replace the saved snapshot.
+  - Receipt counts, pending checks and first-talk receipts survive reconnection.
+    Changing the endpoint restarts the private tracker using the actual connected
+    credentials; editing menu text alone does not retarget a running tracker.
+  - Network menu offers Reconnect with updated settings. Tracker/network status
+    now explains seed/slot mismatches rather than remaining on Starting.
+  - Old saves lack a seed ID: the same endpoint retains existing compatibility;
+    a changed endpoint requires one confirmation in Check Tracker that it is the
+    same AP game. That records the identity and saves without resetting progress.
+    Once recorded, later address changes are automatic. Known wrong seeds or
+    slots cannot use this confirmation to bypass the identity check.
+  - Install matching soh.exe, APCpp.dll and APWorld together. Existing generated
+    seeds are supported; no changes to location/item IDs or placements.
+
