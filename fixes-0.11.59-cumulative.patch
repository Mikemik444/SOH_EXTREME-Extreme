+enum=re.search(r'typedef enum \{([^{}]+)\} GetItemDrawID;', (r/'include/z64item.h').read_text(), re.S)[0]
+rg_names=re.findall(r'^RANDO_ENUM_ITEM\((\w+)\)',(r/'soh/Enhancements/randomizer/randomizerEnums/RandomizerGet.h').read_text(),re.M)
+code=r'''
+#include <cassert>
