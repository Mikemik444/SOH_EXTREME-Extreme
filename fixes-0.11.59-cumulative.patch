diff --git a/Cmake/SohExtremeCrashStack.cmake b/Cmake/SohExtremeCrashStack.cmake
new file mode 100644
index 00000000..bf384e8d
--- /dev/null
+++ b/Cmake/SohExtremeCrashStack.cmake
@@ -0,0 +1,31 @@
+include_guard(GLOBAL)
+function(soh_extreme_crash_stack source_dir)
+    set(path "${source_dir}/src/ship/debug/CrashHandler.cpp")
+    file(READ "${path}" cpp)
+    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SohExtremeCrashStack.cpp.inc" replacement)
+    string(REPLACE "\r\n" "\n" cpp "${cpp}")
+    string(REPLACE "\r\n" "\n" replacement "${replacement}")
+    string(FIND "${cpp}" "${replacement}" fixed)
+    if(NOT fixed EQUAL -1)
+        return()
+    endif()
+    string(FIND "${cpp}" "void CrashHandler::PrintStack(CONTEXT* ctx)" start)
+    string(FIND "${cpp}" "extern \"C\" LONG WINAPI seh_filter" finish)
+    if(start LESS 0 OR finish LESS start)
+        message(FATAL_ERROR "SOH-EXTREME: unrecognized crash stack implementation; not overwritten")
+    endif()
+    math(EXPR length "${finish} - ${start}")
+    string(SUBSTRING "${cpp}" ${start} ${length} original)
+    string(REGEX REPLACE "[ \t\n\r]" "" fingerprint "${original}")
+    string(SHA256 fingerprint "${fingerprint}")
+    if(NOT fingerprint STREQUAL "88c6356c8cee175688e8d32b4070d6b594840d2c5f1af58ba86da7771d1e806d")
+        message(FATAL_ERROR "SOH-EXTREME: crash stack source differs from reviewed revision; not overwritten")
+    endif()
+    string(SUBSTRING "${cpp}" 0 ${start} prefix)
+    string(SUBSTRING "${cpp}" ${finish} -1 suffix)
+    file(WRITE "${path}" "${prefix}${replacement}\n\n${suffix}")
+    message(STATUS "SOH-EXTREME: raw Windows crash addresses enabled")
+endfunction()
+get_target_property(soh_extreme_crash_source libultraship SOURCE_DIR)
+get_filename_component(soh_extreme_crash_root "${soh_extreme_crash_source}" DIRECTORY)
+soh_extreme_crash_stack("${soh_extreme_crash_root}")
diff --git a/Cmake/SohExtremeCrashStack.cpp.inc b/Cmake/SohExtremeCrashStack.cpp.inc
new file mode 100644
index 00000000..df989b7e
--- /dev/null
+++ b/Cmake/SohExtremeCrashStack.cpp.inc
@@ -0,0 +1,60 @@
+// SOH_EXTREME_RAW_CRASH_STACK: retain real addresses even without shipped PDBs.
+void CrashHandler::PrintStack(CONTEXT* ctx) {
+#ifndef _M_ARM64
+    CONTEXT copy = *ctx;
+    PrintRegisters(&copy);
+    HANDLE process = GetCurrentProcess();
+    HANDLE thread = GetCurrentThread();
+    SymSetOptions(SYMOPT_NO_IMAGE_SEARCH | SYMOPT_IGNORE_IMAGEDIR);
+    const bool symbolsReady = SymInitialize(process, "debug", TRUE) != FALSE;
+    STACKFRAME64 stack{};
+#if defined(_M_AMD64)
+    constexpr DWORD machine = IMAGE_FILE_MACHINE_AMD64;
+    stack.AddrPC.Offset = copy.Rip;
+    stack.AddrStack.Offset = copy.Rsp;
+    stack.AddrFrame.Offset = copy.Rbp;
+#else
+    constexpr DWORD machine = IMAGE_FILE_MACHINE_I386;
+    stack.AddrPC.Offset = copy.Eip;
+    stack.AddrStack.Offset = copy.Esp;
+    stack.AddrFrame.Offset = copy.Ebp;
+#endif
+    stack.AddrPC.Mode = stack.AddrStack.Mode = stack.AddrFrame.Mode = AddrModeFlat;
+    AppendLine("Traceback (actual PC, module base and RVA):");
+    for (unsigned frame = 0; frame < 64 && stack.AddrPC.Offset != 0; ++frame) {
+        alignas(SYMBOL_INFO) char storage[sizeof(SYMBOL_INFO) + MAX_SYM_NAME]{};
+        auto* symbol = reinterpret_cast<SYMBOL_INFO*>(storage);
+        symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+        symbol->MaxNameLen = MAX_SYM_NAME;
+        DWORD64 displacement = 0;
+        const bool named = symbolsReady && SymFromAddr(process, stack.AddrPC.Offset, &displacement, symbol);
+        HMODULE module = nullptr;
+        char modulePath[MAX_PATH]{};
+        GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCSTR>(stack.AddrPC.Offset), &module);
+        if (module) GetModuleFileNameA(module, modulePath, MAX_PATH);
+        const DWORD64 base = reinterpret_cast<DWORD64>(module);
+        char row[160];
+        snprintf(row, sizeof(row), "    #%u PC=0x%016llX base=0x%016llX RVA=0x%llX ",
+                 frame, stack.AddrPC.Offset, base, base ? stack.AddrPC.Offset - base : 0);
+        AppendStr(row);
+        AppendStr(named ? symbol->Name : "<unresolved>");
+        AppendStr(" in ");
+        AppendLine(module ? modulePath : "<unknown module>");
+        const DWORD64 pc = stack.AddrPC.Offset, sp = stack.AddrStack.Offset;
+        if (!StackWalk64(machine, process, thread, &stack, &copy, nullptr,
+                         SymFunctionTableAccess64, SymGetModuleBase64, nullptr)) break;
+        // DbgHelp's first step can describe the current frame again. Advance
+        // once more before treating an unchanged frame as a broken unwind.
+        if (pc == stack.AddrPC.Offset && sp == stack.AddrStack.Offset) {
+            if (frame != 0 || !StackWalk64(machine, process, thread, &stack, &copy, nullptr,
+                              SymFunctionTableAccess64, SymGetModuleBase64, nullptr) ||
+                (pc == stack.AddrPC.Offset && sp == stack.AddrStack.Offset)) break;
+        }
+    }
+    if (symbolsReady) SymCleanup(process);
+    PrintCommon();
+    Context::GetRawInstance()->GetLogger()->flush();
+    spdlog::shutdown();
+#endif
+}
diff --git a/Cmake/SohExtremeGfxStep.cpp.inc b/Cmake/SohExtremeGfxStep.cpp.inc
new file mode 100644
index 00000000..1d69e7c1
--- /dev/null
+++ b/Cmake/SohExtremeGfxStep.cpp.inc
@@ -0,0 +1,37 @@
+// SOH_EXTREME_GFX_STEP: a bad command invalidates the remainder of this frame.
+// Capture raw words before a handler can advance a multiword command. Do not
+// dereference a corrupt resource pointer while writing the diagnostic.
+static bool SohExtremeGfxStep() {
+    const auto* cmd = g_exec_stack.currCmd();
+    const auto w0 = cmd->words.w0;
+    const auto w1 = cmd->words.w1;
+    try {
+        gfx_step();
+        return true;
+    } catch (const SohExtremeInvalidGfx& fault) {
+        static uint64_t rejectedFrames = 0;
+        if (rejectedFrames != UINT64_MAX) {
+            ++rejectedFrames;
+        }
+        // A persistent bad model must not fill the log every rendered frame.
+        if (rejectedFrames <= 8 || (rejectedFrames & (rejectedFrames - 1)) == 0) {
+            SPDLOG_ERROR("[SOH-EXTREME] Rejected graphics frame #{}: {} ({}, {}), "
+                         "cmd=0x{:X} w0=0x{:X} w1=0x{:X} ucode={} depth={}",
+                         rejectedFrames, fault.reason, fault.first, fault.second,
+                         reinterpret_cast<uintptr_t>(cmd), w0, w1,
+                         static_cast<uint32_t>(ucode_handler_index), g_exec_stack.cmd_stack.size());
+            // Addresses identify the display-list callers without trusting
+            // embedded filenames or reading the callers' command data.
+            const auto& path = g_exec_stack.gfx_path;
+            const size_t begin = path.size() > 8 ? path.size() - 8 : 0;
+            for (size_t i = begin; i < path.size(); ++i) {
+                SPDLOG_ERROR("[SOH-EXTREME] Graphics caller {}: 0x{:X}", i,
+                             reinterpret_cast<uintptr_t>(path[i]));
+            }
+        }
+        g_exec_stack.stop();
+        g_exec_stack.disp_stack.clear();
+        return false;
+    }
+}
+
