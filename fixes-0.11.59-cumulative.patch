diff --git a/Cmake/SohExtremeVertexGuard.cpp.inc b/Cmake/SohExtremeVertexGuard.cpp.inc
new file mode 100644
index 00000000..a3424b19
--- /dev/null
+++ b/Cmake/SohExtremeVertexGuard.cpp.inc
@@ -0,0 +1,23 @@
+// SOH_EXTREME_VERTEX_GUARD: unwind only a rejected graphics command, never an
+// arbitrary engine exception. Keep these checks active in Release builds.
+struct SohExtremeInvalidGfx {
+    const char* reason;
+    size_t first;
+    size_t second;
+};
+
+static void SohExtremeCheckVertexRange(size_t start, size_t count, size_t capacity) {
+    // Subtract after checking start: malformed F3DEX2 commands can underflow
+    // their destination index, and filepath commands carry full-width counts.
+    if (start > capacity || count > capacity - start) {
+        throw SohExtremeInvalidGfx{ "vertex range", start, count };
+    }
+}
+
+static void SohExtremeCheckVertexLoad(size_t start, size_t count, const F3DVtx* vertices) {
+    SohExtremeCheckVertexRange(start, count, MAX_VERTICES);
+    if (count != 0 && vertices == nullptr) {
+        throw SohExtremeInvalidGfx{ "null vertex source", start, count };
+    }
+}
+
diff --git a/Cmake/SohExtremeVertexSafety.cmake b/Cmake/SohExtremeVertexSafety.cmake
new file mode 100644
index 00000000..0f8acfb9
--- /dev/null
+++ b/Cmake/SohExtremeVertexSafety.cmake
@@ -0,0 +1,57 @@
+include_guard(GLOBAL)
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_LIST_DIR}/SohExtremeVertexEdits.json"
+    "${CMAKE_CURRENT_LIST_DIR}/SohExtremeVertexGuard.cpp.inc"
+    "${CMAKE_CURRENT_LIST_DIR}/SohExtremeGfxStep.cpp.inc")
+function(soh_extreme_vertex_safety source_dir)
+    file(LOCK "${source_dir}/.soh-extreme-vertex.lock" GUARD FUNCTION TIMEOUT 120)
+    set(path "${source_dir}/src/fast/interpreter.cpp")
+    file(READ "${path}" cpp)
+    string(REPLACE "\r\n" "\n" cpp "${cpp}")
+    set(original "${cpp}")
+    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SohExtremeVertexEdits.json" edits)
+    string(JSON count LENGTH "${edits}")
+    math(EXPR last "${count} - 1")
+    foreach(i RANGE 0 ${last})
+        string(JSON before GET "${edits}" ${i} before)
+        string(JSON after GET "${edits}" ${i} after)
+        string(JSON fragment ERROR_VARIABLE no_fragment GET "${edits}" ${i} fragment)
+        if(NOT no_fragment)
+            file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${fragment}" body)
+            string(REPLACE "\r\n" "\n" body "${body}")
+            string(REPLACE "@FRAGMENT@" "${body}" after "${after}")
+        endif()
+        string(FIND "${cpp}" "${after}" fixed)
+        if(NOT fixed EQUAL -1)
+            continue()
+        endif()
+        if(NOT no_fragment)
+            string(REGEX MATCH "^[^\n]+" marker "${body}")
+            string(FIND "${cpp}" "${marker}" modified)
+            if(NOT modified EQUAL -1)
+                message(FATAL_ERROR "SOH-EXTREME: altered vertex guard ${i}; nothing was overwritten.")
+            endif()
+        endif()
+        string(FIND "${cpp}" "${before}" start)
+        if(start LESS 0)
+            message(FATAL_ERROR "SOH-EXTREME: unrecognized vertex renderer edit ${i}; nothing was overwritten.")
+        endif()
+        string(LENGTH "${before}" length)
+        math(EXPR finish "${start} + ${length}")
+        string(SUBSTRING "${cpp}" ${finish} -1 suffix)
+        string(FIND "${suffix}" "${before}" duplicate)
+        if(NOT duplicate EQUAL -1)
+            message(FATAL_ERROR "SOH-EXTREME: ambiguous vertex renderer edit ${i}; nothing was overwritten.")
+        endif()
+        string(SUBSTRING "${cpp}" 0 ${start} prefix)
+        set(cpp "${prefix}${after}${suffix}")
+    endforeach()
+    # Commit only after every reviewed edit matched, so failures are atomic.
+    if(NOT cpp STREQUAL original)
+        file(WRITE "${path}" "${cpp}")
+        message(STATUS "SOH-EXTREME: vertex bounds and malformed graphics frame guards installed")
+    endif()
+endfunction()
+get_target_property(soh_extreme_vertex_source libultraship SOURCE_DIR)
+get_filename_component(soh_extreme_vertex_root "${soh_extreme_vertex_source}" DIRECTORY)
+soh_extreme_vertex_safety("${soh_extreme_vertex_root}")
diff --git a/SOH_AP_FIX_HISTORY.txt b/SOH_AP_FIX_HISTORY.txt
new file mode 100644
index 00000000..972cc701
--- /dev/null
+++ b/SOH_AP_FIX_HISTORY.txt
@@ -0,0 +1,892 @@
+0.11.59 - Malformed graphics frame and vertex bounds protection (2026-10-02)
+  - The 17:11 Jabu-Jabu crash in the supplied log resolves against the saved
+    .55 symbols to GfxSpModifyVertex. The register value is vertex index
+    0x4DFF (19,967), beyond the 64 normal vertex slots. An unknown opcode
+    was logged immediately beforehand. This is an access violation, not
+    evidence that receipt history exhausted memory.
+  - Release builds now validate vertex load ranges, vertex modifications,
+    triangle indices and conditional-branch vertex indices before access.
+    Rectangle rendering retains its four reserved scratch vertices. Range
+    validation handles unsigned underflow/overflow and null load sources.
+  - Unknown opcodes, invalid microcode and rejected vertex operations stop
+    the affected frame. No subsequent commands from that frame are executed.
+    Valid queued geometry is flushed before restoring the normal framebuffer;
+    display-list state is cleared and the next frame starts normally.
+  - Diagnostics record raw command words, microcode and bounded caller
+    addresses. Repeated errors are rate limited, with no accumulating queue.
+    Unrelated exceptions are not swallowed. The malformed-command producer
+    is still unidentified; this protects the demonstrated failure path.
+  - A controlled protected-page test reproduces the old access violation.
+    185,922 assertions pass for the new guard and actual frame/dispatch code.
+    Build-time patch tests cover idempotence and atomic rejection of changed
+    or ambiguous source. Windows Release build is verified separately.
+    No live game/GPU playtest. Existing saves, IDs and placements are unchanged.
+
+0.11.58 - Bottom of the Well Crawl and AP shop purchases (2026-10-02)
+  - The AP entryway-to-perimeter route now requires child access and Crawl,
+    before passing the corridor spider. The reverse route also requires the
+    return ladder's Climb, matching native entrance/corridor logic.
+  - All six EXTREME Botw Boulder checks are anchored in the basement rather
+    than the entryway before the crawlspace. Rock / Boulder Soul and a usable
+    breaking method remain required. Entering the basement does not add Climb.
+  - Replaced the stock checks' name-prefix Crawl workaround with the actual
+    entrance gate, so checks and events inherit the route regardless of name.
+    Private enemy and silver room routes retain their native Crawl conditions.
+  - AP-owned shop shelves use one-time check callbacks even while waiting for
+    scouts, when their temporary native placement might still be a shield.
+    Local item obtainability cannot reject an AP purchase based on a duplicate,
+    missing bottle/upgrade, remote model or trap disguise. Rupee cost and the
+    shelf's purchased flag remain enforced. Native shop restrictions remain.
+  - AP still supports 0-7 randomized items per shop. Ship's local eighth-item
+    setting cannot create a server check in an existing seven-item AP seed.
+    No extra check or replacement placement is invented by this update.
+  - 60,612 real AP/Universal Tracker assertions pass; old .57 fails 608.
+    182,402 compiled shop assertions pass; old .57 fails 15,680. Existing price
+    and payment regressions pass. Windows Release build verified separately.
+    IDs and placements are preserved. No live game playtest was performed.
+
+0.11.57 - Deku Tree talking-scrub door requirements (2026-10-01)
+  - The vanilla 2F middle-room doors now require the hint scrub's own enemy
+    soul and Deku speech, in addition to nut reflection or usable Hammer.
+    All Slingshot-room checks inherit this route in AP and native logic.
+    The private enemy-room graph uses the same corrected gate.
+  - The boss-door scrub puzzle uses the same soul/speech prerequisites and
+    keeps its reflection requirement. All five hint-scrub defeat checks
+    require completing the conversation before their drops are reported.
+  - En_Hintnuts becomes a BG actor after surrender and can auto-accept talk.
+    Both paths now honor Speak Deku; previously the NPC-only speech filter
+    skipped them. Ordinary mandatory NPC dialogue behavior is unchanged.
+  - Individual mode requires Deku Scrub Soul; shared mode uses Enemy Soul.
+    Speak mode uses Speak or Speak Deku as configured. Disabled shuffles
+    are innate. Merchant Scrub Soul and NPC Soul are not substituted or
+    added: these hint scrubs remain enemy-soul actors.
+  - Actual owned shields, child/adult weapon use, Climb and Open Chest remain
+    separate requirements. IDs, save data and existing placements are unchanged.
+    AP/UT and compiled native regression tests cover the missing requirements,
+    shared/off settings, restored slots and forced dialogue. No live playtest.
+
+0.11.56 - Zora River heart approach and rock obstruction (2026-10-01)
+  - ZR Near Domain Freestanding PoH now requires reaching the upper path before
+    using Boomerang, Cucco or the adult collection alternatives. The normal
+    approach needs Climb plus swimming or a usable Cucco for child. The adult
+    grown-bean approach remains valid after an actual child planting visit.
+  - AP's front river obstruction now matches the native game: Rock / Boulder
+    Soul plus a working rock-breaking action, or the deeper diving alternate.
+    With Swim shuffled, the latter needs two physical Progressive Scales.
+    The reverse crossing uses the same rule; explosives alone cannot cross
+    soul-locked rocks. Disabled shuffles keep their capabilities innate.
+  - GV Waterfall Freestanding PoH was verified without changing its rules:
+    child Cucco Soul + Grab can glide from the bridge into the alcove; the
+    other route needs Swim + Climb. Boomerang alone does not reach the alcove.
+  - AP/UT regression coverage includes missing capabilities, both ages,
+    individual/shared/disabled souls, shuffle-off options and restored slots.
+    Compiled native checks also preserve ladder tricks and adult bean routes.
+    Existing IDs and placements are preserved. No live gameplay test performed.
+
+0.11.55 - Bean-fairy soil requirements and Lost Woods diving (2026-10-01)
+  - The eight child Lost Woods underwater shortcut rupees require Silver
+    Scale rather than Golden Scale in native and AP logic: two physical
+    Progressive Scales with Swim shuffled (first Swim, second deeper diving).
+  - Lost Woods access remains a separate region requirement. The direct
+    Kokiri approach needs Climb; a reachable outside route through Goron City
+    or the Zora River shortcut can substitute. Two scales alone do not assume
+    an escape from a closed forest when Climb and every outside route are absent.
+  - The three Lost Woods bean fairies near Deku Theater now require usable
+    beans at that exact plot, including Lost Woods Bean Soul when shuffled.
+    Possessing beans or the other Lost Woods plot's soul cannot substitute.
+  - Audited all 30 bean fairies across ten plots: child access, beans, the
+    matching soil/Bean Soul, playable Song of Storms, an ocarina and its
+    A/C-Up/C-Down buttons. Individual-notes mode requires all six storm notes.
+    Disabled soul/button shuffles remain innate. Passive Flow of Time is
+    independent of explicitly playing the song to water a planted bean.
+  - 8,364 bean-fairy AP/Universal Tracker assertions cover each missing requirement,
+    wrong-plot souls, both ages, notes and full-song modes, shuffle-off settings
+    and restored slots. Existing IDs and placements are preserved. No live
+    gameplay test performed. Another 3,040 AP/UT assertions cover scale counts,
+    local/outside routes, closed forest, both ages and restored tracker slots;
+    128 compiled native assertions preserve Swim and child-only requirements.
+
+0.11.54 - DMT Cow Grotto below the summit climb (2026-10-01)
+  - AP and Universal Tracker now include the trail-to-cow-grotto route below
+    the summit climbing wall. Shovel, explosives (bombs or usable Bombchus),
+    and Rock / Boulder Soul suffice once Link can reach Death Mountain Trail.
+    Shovel and rock soul remain innate when their shuffles are disabled.
+  - The grotto exit returns to the trail, not the summit. Entering the grotto
+    cannot bypass the summit's Climb requirement. The separate summit approach
+    remains available for players who arrive from above.
+  - The loose rupees and hearts need no Cow Soul, Epona's Song or Climb. The
+    cow, grass and beehive retain their own interaction requirements.
+  - 3,525 AP/Universal Tracker assertions pass for child/adult starts,
+    bombs/Bombchus, missing requirements, shuffle-off modes and restored slots. IDs and
+    existing placements are unchanged. No live gameplay test performed.
+
+0.11.53 - Fishing Pond sign access and paired Ocarina checks (2026-10-01)
+  - Collecting the moat Ocarina of Time pickup completes its separate Song from
+    Ocarina of Time check immediately. AP rewards can arrive without a textbox;
+    the song no longer waits for that textbox or a later unrelated item.
+  - Older AP saves with the moat pickup flag but no song flag recover on a
+    gameplay update. The normal flag/check journal handles reporting, with
+    no duplicate native reward or grant of the actual Song of Time. The AP
+    actor is disarmed so an unrelated textbox cannot trigger a late cutscene.
+    Vanilla and non-AP randomizer cutscene behavior remains unchanged.
+  - Check 9700534 now belongs to the actual Fishing Hole interior. The native
+    FISHING_POND token and AP FISHING_HOLE token are explicitly matched in
+    region creation and route projection. It no longer falls back to Lake Hylia.
+  - With locked overworld doors, the sign inherits Fishing Hole Key or Skeleton
+    Key and the island approach. Sign Soul is still required when shuffled.
+    Unlocked doors need no key; the outdoor Fishing Sign stays outside the lock.
+  - The native game already has the correct interior placement and door rule.
+    AP generation and restored Universal Tracker slots now match it. Reading
+    the sign does not require the fishing rod, Fish Soul or the owner's speech.
+  - 422 AP/UT assertions exercise both ages, missing keys, wrong keys, Skeleton
+    Key, Sign Soul on/off, locked/unlocked doors and restored slot settings.
+    114 compiled native assertions cover the paired pickup, missing textbox,
+    old-save recovery, duplicate prevention and non-AP cutscene behavior.
+    Existing IDs and placements are preserved. No live gameplay test performed.
+
+0.11.52 - Owl perch access and exact Hylian speech (2026-10-01)
+  - Child Lake Hylia grave access requires NPC Soul and Speak Hylian when
+    shuffled so the owl can fly away and unlock the grave's pull switch.
+    Pulling requires Grab; this is not a rock and needs no Rock/Boulder Soul.
+    Adult access bypasses the owl. Grotto contents keep their Shovel and other
+    individual interaction requirements. Scrub Soul applies to the merchants,
+    not the hive merely named after their grotto.
+  - The Death Mountain summit upper exit sign has the same child owl gate.
+    Adult sign access remains independent of NPC Soul and speech. The existing
+    summit approach and Sign Soul still apply.
+  - Both owl flights and the Kaepora first-conversation check require Hylian,
+    matching the runtime speech hook. Shared Speak mode uses Speak; disabled
+    shuffles remain innate. IDs and existing item placements are preserved.
+  - AP/Universal Tracker and compiled native regression tests cover ages,
+    individual/shared/off speech, soul shuffle modes, wrong languages, Grab,
+    Shovel and restored slot settings. No live game playtest was performed.
+
+0.11.51 - Deku Theater leader soul requirement (2026-10-01)
+  - The Skull Mask reward now requires NPC Soul when that shuffle is enabled,
+    matching the hidden prize-giving leader even while the audience is visible.
+  - Native logic also explicitly requires the leader for both theater rewards.
+    Skull Mask keeps its automatic dialogue without a speech requirement;
+    Mask of Truth retains its Deku speech requirement. Shovel/access still apply.
+  - AP and Universal Tracker regressions cover all speech/soul shuffle modes
+    and restored existing slot settings. Native Release build verified.
+    No live game playtest was performed.
+  - Existing placements are unchanged. This corrects reachability; it cannot
+    repair progression cycles already generated into an older seed.
+
+0.11.50 - Gerudo guard gate requirements (2026-10-01)
+  - Gerudo Training Ground's paid gate event now requires NPC Soul and Gerudo
+    speech when shuffled, alongside adult access, membership card and wallet.
+    Shared Speak mode uses Speak; individual-language mode uses Speak Gerudo.
+  - The Haunted Wasteland gate's guard events now have the same NPC/speech
+    requirements. The normal fortress-side route also needs Climb to reach the
+    operator's tower when Climb is shuffled. Reverse arrivals keep their own
