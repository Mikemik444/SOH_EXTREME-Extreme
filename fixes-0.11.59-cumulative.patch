+// SOH_EXTREME_TLUT_COMPLETE_GUARD: validate/copy the whole transfer before
+// publishing either palette half. ReadProcessMemory safely fails if a source
+// page becomes inaccessible; a VirtualQuery followed by memcpy can race.
+static bool SohExtremeCopyTlut(uint8_t* dst, const uint8_t* src, size_t bytes) {
+    if (src == nullptr || bytes == 0 || bytes > 512 ||
+        reinterpret_cast<uintptr_t>(src) > UINTPTR_MAX - bytes) return false;
+#ifdef _WIN32
+    SIZE_T copied = 0;
+    return ReadProcessMemory(GetCurrentProcess(), src, dst, bytes, &copied) != 0 && copied == bytes;
+#else
+    memcpy(dst, src, bytes);
+    return true;
+#endif
+}
+
+void Interpreter::GfxDpLoadTlut(uint8_t tile, uint32_t high_index) {
+    if (tile >= 8 || high_index >= 256 || mRdp->texture_to_load.siz != G_IM_SIZ_16b) return;
+    const uint16_t tmem = mRdp->texture_tile[tile].tmem;
+    if (tmem >= 512) return;
+    const uint8_t* src = mRdp->texture_to_load.addr;
+    const uint32_t byteCount = (high_index + 1) * 2;
+    // Keep the legacy nonstandard lower-TMEM fallback in the second palette
+    // half, but stage it too instead of retaining an unchecked source pointer.
+    const uint32_t paletteOffset = tmem >= 256 ? (tmem - 256) * 2 : 256;
+    const uint32_t copyLen = std::min(byteCount, 512u - paletteOffset);
+    uint8_t transfer[512];
+    if (!SohExtremeCopyTlut(transfer, src, copyLen)) {
+        // Rate-limit malformed display lists without hiding the first report.
+        static unsigned reports = 0;
+        if (reports++ < 8) SPDLOG_ERROR("SOH-EXTREME: rejected unreadable TLUT source {:p}, {} bytes, tile {}, tmem {}",
+            static_cast<const void*>(src), copyLen, tile, tmem);
+        return;
+    }
+    uint32_t copied = 0;
+    while (copied < copyLen) {
+        const uint32_t destination = paletteOffset + copied;
+        const uint32_t half = destination / 256;
+        const uint32_t offset = destination % 256;
+        const uint32_t size = std::min(copyLen - copied, 256u - offset);
+        memcpy(mRdp->palette_staging[half] + offset, transfer + copied, size);
+        mRdp->palettes[half] = mRdp->palette_staging[half];
+        mRdp->palette_dram_addr[half] = src + copied;
+        copied += size;
+    }
+}
+
diff --git a/Cmake/SohExtremeTlutSafety.cmake b/Cmake/SohExtremeTlutSafety.cmake
new file mode 100644
index 00000000..19edc45a
--- /dev/null
+++ b/Cmake/SohExtremeTlutSafety.cmake
@@ -0,0 +1,39 @@
+include_guard(GLOBAL)
+function(soh_extreme_tlut_safety source_dir)
+    file(LOCK "${source_dir}/.soh-extreme-tlut.lock" GUARD FUNCTION TIMEOUT 120)
+    set(path "${source_dir}/src/fast/interpreter.cpp")
+    file(READ "${path}" cpp)
+    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SohExtremeTlut.cpp.inc" replacement)
+    string(REPLACE "\r\n" "\n" cpp "${cpp}")
+    string(REPLACE "\r\n" "\n" replacement "${replacement}")
+    string(FIND "${cpp}" "${replacement}" fixed)
+    if(NOT fixed EQUAL -1)
+        return()
+    endif()
+    string(FIND "${cpp}" "SOH_EXTREME_TLUT_COMPLETE_GUARD" modified)
+    string(FIND "${cpp}" "void Interpreter::GfxDpLoadTlut(" start)
+    string(FIND "${cpp}" "void Interpreter::GfxDpLoadBlock(" finish)
+    if(NOT modified EQUAL -1 OR start LESS 0 OR finish LESS start)
+        message(FATAL_ERROR "SOH-EXTREME: unrecognized TLUT implementation; renderer was not overwritten.")
+    endif()
+    math(EXPR length "${finish} - ${start}")
+    string(SUBSTRING "${cpp}" ${start} ${length} original)
+    string(REGEX REPLACE "[ \t\n\r]" "" fingerprint "${original}")
+    string(SHA256 fingerprint "${fingerprint}")
+    # Reviewed staging implementation, with or without its earlier partial guard.
+    if(NOT fingerprint STREQUAL "c47cc929857f14a0514bf7d4123528dce88e670996945316d55eb1cbf92c660f"
+       AND NOT fingerprint STREQUAL "a2c21fc46c2acbee751706636c309b01006656addeefe036aaa3edbfed7a447c")
+        message(FATAL_ERROR "SOH-EXTREME: TLUT source differs from the reviewed revision; nothing was overwritten.")
+    endif()
+    string(SUBSTRING "${cpp}" 0 ${start} prefix)
+    string(SUBSTRING "${cpp}" ${finish} -1 suffix)
+    set(cpp "${prefix}${replacement}\n${suffix}")
+    if(NOT cpp MATCHES "#include <[Ww]indows.h>")
+        string(PREPEND cpp "#ifdef _WIN32\n#ifndef NOMINMAX\n#define NOMINMAX\n#endif\n#include <windows.h>\n#endif\n")
+    endif()
+    file(WRITE "${path}" "${cpp}")
+    message(STATUS "SOH-EXTREME: complete TLUT source/bounds guard installed")
+endfunction()
+get_target_property(soh_extreme_lus_source libultraship SOURCE_DIR)
+get_filename_component(soh_extreme_lus_root "${soh_extreme_lus_source}" DIRECTORY)
+soh_extreme_tlut_safety("${soh_extreme_lus_root}")
