+
+common = dict(closed_forest='off', starting_age='child', door_of_time='song_only',
+    shuffle_speak='off', shuffle_npc_soul=False, lock_overworld_doors=False,
+    song_note_shuffle='off', shuffle_ocarina_buttons=False,
