+    if (itemId < AP_FIRST_SONG_NOTE || itemId > AP_LAST_SONG_NOTE) return RG_NONE;
+    int note = static_cast<int>(itemId - AP_FIRST_SONG_NOTE);
+    for (const auto& song : kApSongNotes) {
