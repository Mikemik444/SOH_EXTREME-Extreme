static int ocCalls=0,animationCalls=0,offerTextCalls=0,eventCalls=0,ocarinaCalls=0;
static bool moveMidoOverride=false,quest=false;static bool eventFlags[32]{};
static bool gDbgCamEnabled=false;static struct {int linkAge=1;}gSaveContext;
static int gMidoHandsOnHipsIdleAnim;
