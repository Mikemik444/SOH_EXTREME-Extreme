static bool BgCheck_SphVsDynaWallInBgActor(CollisionContext*,u16,DynaCollisionContext*,SSList*,float*x,float*z,
    CollisionPoly**poly,s32*bg,Vec3f*pos,float,s32 id){++geometryCalls;*x=pos->x+1;*z=pos->z;*poly=&hitPoly;*bg=id;return true;}
static bool BgCheck_CheckDynaCeilingList(CollisionContext*,u16,DynaCollisionContext*,SSList*,float*y,Vec3f*,float,CollisionPoly**p){
    ++geometryCalls;*y=1;*p=&hitPoly;return true;}
