@MIDO@

static unsigned assertions=0,cases=0;
#define CHECK(c) do{++assertions;if(!(c)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#c);return 1;}}while(false)
static void model(Actor*,PlayState*){++modelCalls;}
static void shadow(Actor*,Lights*,PlayState*){++shadowCalls;}
static Actor actor(int id,int params=0){
    Actor a;a.id=id;a.params=params;a.category=ACTORCAT_NPC;a.flags=ACTOR_FLAG_ATTENTION_ENABLED;
    a.world.pos={100,20,300};a.world.rot={1,200,3};a.draw=model;a.shape.shadowDraw=shadow;
    a.xzDistToPlayer=30;return a;
}
static void reset(){
    state=PlayState{};player=Player{};state.player=&player;state.sceneNum=SCENE_KOKIRI_FOREST;gPlayState=&state;
    for(int i=0;i<4;++i){options[i]=true;souls[i]=false;}
    for(auto&event:eventFlags)event=false;
    isRando=true;modelCalls=shadowCalls=npcGlowCalls=enemyGlowCalls=renderOpenCalls=0;
    ocCalls=animationCalls=offerTextCalls=eventCalls=ocarinaCalls=0;
    npcGlow=offscreen=cutscene=moveMidoOverride=quest=false;
}
static bool near(float a,float b){return std::fabs(a-b)<0.001f;}
static bool focusAt(const Actor&a,float height){return near(a.focus.pos.x,a.world.pos.x)&&
    near(a.focus.pos.y,a.world.pos.y+height)&&near(a.focus.pos.z,a.world.pos.z)&&a.focus.rot.y==a.world.rot.y;}
static bool canTalk(Actor&a){player.talkActor=&a;bool should=true;SoulSpeak(&should);return should;}
int main(){
    reset();
    struct Placement{int id,params,scene;float height;};
    const Placement allowed[]={
        {ACTOR_EN_MD,0,SCENE_KOKIRI_FOREST,50},{ACTOR_EN_MD,-1,SCENE_LOST_WOODS,50},
        {ACTOR_EN_KZ,0,0,100},{ACTOR_EN_HEISHI1,0,SCENE_HYRULE_CASTLE,60},
        {ACTOR_EN_HEISHI3,0,0,60},{ACTOR_EN_GE2,0,0,60},
        {ACTOR_EN_KO,3,SCENE_KOKIRI_FOREST,50},{ACTOR_EN_KO,0x1203,SCENE_KOKIRI_FOREST,50},
        {ACTOR_EN_HEISHI2,2,0,70},{ACTOR_EN_HEISHI2,0x1205,0,70},
        {ACTOR_EN_GE1,0,0,60},{ACTOR_EN_GE1,1,0,60},{ACTOR_EN_GE1,0x1246,0,60},
        {ACTOR_EN_TA,0,SCENE_HYRULE_CASTLE,60},{ACTOR_EN_TA,-1,SCENE_HYRULE_CASTLE,60}};
    for(const auto&p:allowed){
        reset();state.sceneNum=p.scene;Actor a=actor(p.id,p.params);
        CHECK(MegaSoul_IsPathBlockingNpcPlacement(p.id,p.params,p.scene));
        CHECK(MegaSoul_IsPathBlockingNpc(&a)&&MegaSoul_ShouldHideActor(&a));
        SoulInit(&a);CHECK(a.draw==model&&(a.flags&ACTOR_FLAG_ATTENTION_ENABLED)&&focusAt(a,p.height));
        a.world.pos={201,45,404};a.world.rot.y=300;bool update=true;SoulUpdate(&a,&update);
        CHECK(update&&focusAt(a,p.height)&&canTalk(a));
        Actor_Draw(&state,&a);CHECK(modelCalls==0&&shadowCalls==0&&npcGlowCalls==0&&enemyGlowCalls==0&&renderOpenCalls==0);
        souls[RAND_INF_NPC_SOUL]=true;CHECK(!MegaSoul_ShouldHideActor(&a));
        Actor_Draw(&state,&a);CHECK(modelCalls==1&&shadowCalls==1&&npcGlowCalls==1&&enemyGlowCalls==1&&renderOpenCalls==1);
    }
    ++cases;std::puts("PASS every allowed NPC placement stays initialized, targetable, updateable and talkable while completely hidden, then renders on acquisition");
    const Placement denied[]={
        {ACTOR_EN_KO,0,SCENE_KOKIRI_FOREST,0},{ACTOR_EN_KO,2,SCENE_KOKIRI_FOREST,0},
        {ACTOR_EN_KO,4,SCENE_KOKIRI_FOREST,0},{ACTOR_EN_KO,0x1202,SCENE_KOKIRI_FOREST,0},
        {ACTOR_EN_HEISHI2,0,0,0},{ACTOR_EN_HEISHI2,1,0,0},{ACTOR_EN_HEISHI2,3,0,0},
        {ACTOR_EN_HEISHI2,4,0,0},{ACTOR_EN_HEISHI2,6,0,0},{ACTOR_EN_HEISHI2,0x1204,0,0},
        {ACTOR_EN_GE1,2,0,0},{ACTOR_EN_GE1,3,0,0},{ACTOR_EN_GE1,0x45,0,0},{ACTOR_EN_GE1,0x47,0,0},
        {ACTOR_EN_TA,1,SCENE_HYRULE_CASTLE,0},{ACTOR_EN_TA,2,SCENE_HYRULE_CASTLE,0},
        {ACTOR_EN_TA,0,SCENE_KOKIRI_FOREST,0},{ACTOR_EN_TA,0,-1,0},{ACTOR_EN_RU1,0,0,0}};
    for(const auto&p:denied){
        reset();state.sceneNum=p.scene;Actor a=actor(p.id,p.params);
        CHECK(!MegaSoul_IsPathBlockingNpcPlacement(p.id,p.params,p.scene));
        SoulInit(&a);bool update=true;SoulUpdate(&a,&update);
        CHECK(a.draw==nullptr&&!(a.flags&ACTOR_FLAG_ATTENTION_ENABLED)&&!update&&!canTalk(a));
    }
    ++cases;std::puts("PASS ordinary NPCs and wrong guard/Kokiri/Talon variants retain the existing hidden, frozen, untalkable behavior");
    reset();CHECK(!MegaSoul_IsPathBlockingNpc(nullptr)&&!MegaSoul_ShouldHideActor(nullptr));SoulInit(nullptr);
    Actor talon=actor(ACTOR_EN_TA);gPlayState=nullptr;CHECK(!MegaSoul_IsPathBlockingNpc(&talon));gPlayState=&state;
    Actor midoActor=actor(ACTOR_EN_MD);options[RSK_SHUFFLE_NPC_SOUL]=false;SoulInit(&midoActor);
    CHECK(!MegaSoul_ShouldHideActor(&midoActor)&&canTalk(midoActor));
    options[RSK_SHUFFLE_NPC_SOUL]=true;isRando=false;CHECK(!MegaSoul_ShouldHideActor(&midoActor));
    ++cases;std::puts("PASS null scene/actor handling and disabled/randomizer-off rendering remain safe");
    reset();
    for(int id:{ACTOR_EN_ISHI,ACTOR_OBJ_BOMBIWA,ACTOR_OBJ_HAMISHI,ACTOR_BG_JYA_BOMBCHUIWA,ACTOR_OBJ_KIBAKO,ACTOR_OBJ_KIBAKO2}){
        Actor a=actor(id);a.category=ACTORCAT_PROP;Actor_Draw(&state,&a);
        CHECK(modelCalls==0&&shadowCalls==0&&npcGlowCalls==0&&enemyGlowCalls==0&&renderOpenCalls==0);
    }
    souls[RAND_INF_ROCK_SOUL]=souls[RAND_INF_CRATE_SOUL]=true;
    for(int id:{ACTOR_EN_ISHI,ACTOR_OBJ_BOMBIWA,ACTOR_OBJ_HAMISHI,ACTOR_BG_JYA_BOMBCHUIWA,ACTOR_OBJ_KIBAKO,ACTOR_OBJ_KIBAKO2}){
        Actor a=actor(id);a.category=ACTORCAT_PROP;CHECK(!MegaSoul_ShouldHideActor(&a));Actor_Draw(&state,&a);
    }
    CHECK(modelCalls==6&&shadowCalls==6&&npcGlowCalls==6&&enemyGlowCalls==6);
    for(int id:{ACTOR_BG_JYA_BOMBIWA,ACTOR_EN_GOROIWA,ACTOR_BG_JYA_GOROIWA}){
        Actor a=actor(id);souls[RAND_INF_ROCK_SOUL]=false;CHECK(!MegaSoul_ShouldHideActor(&a));
    }
    ++cases;std::puts("PASS central rendering hides all intended rock/crate families before model/shadow/glow and preserves wall/rolling hazards");
    reset();
    for(int id:{ACTOR_EN_COW,ACTOR_EN_DNS,ACTOR_EN_SHOPNUTS,ACTOR_EN_SW,ACTOR_EN_SI}){
        Actor a=actor(id);CHECK(!IsMegaNpcSoulActor(&a));
    }
    Actor fish=actor(ACTOR_FISHING,100);CHECK(!IsMegaNpcSoulActor(&fish));fish.params=99;CHECK(IsMegaNpcSoulActor(&fish));
    Actor sign=actor(ACTOR_EN_KANBAN);CHECK(!canTalk(sign));
    ++cases;std::puts("PASS animal/scrub/Skulltula/fishing classifications and the separate Sign Soul speech gate stay intact");

    reset();Actor a=actor(ACTOR_EN_MD);SoulInit(&a);s16 talk=NPC_TALK_STATE_IDLE;
    CHECK(!Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04));
    CHECK(player.talkActor==&a&&a.textId==0x1040&&offerTextCalls==1);
    CHECK(projectedFocus.x==a.world.pos.x&&projectedFocus.y==a.world.pos.y+50&&projectedFocus.z==a.world.pos.z);
    CHECK(canTalk(a));a.flags|=ACTOR_FLAG_TALK;
    CHECK(Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04)&&talk==NPC_TALK_STATE_TALKING&&!(a.flags&ACTOR_FLAG_TALK));
    CHECK(!Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04)&&talk==NPC_TALK_STATE_IDLE);
    player.talkActor=nullptr;offscreen=true;CHECK(!Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04)&&player.talkActor==nullptr);
    offscreen=false;a.xzDistToPlayer=100;CHECK(!Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04)&&player.talkActor==nullptr);
    a.xzDistToPlayer=30;a.yDistToPlayer=100;CHECK(!Npc_UpdateTalking(&state,&a,&talk,60,EnMd_GetText,func_80AAAF04)&&player.talkActor==nullptr);
    ++cases;std::puts("PASS actual native talk state/offer path uses hidden world-relative focus and retains distance/offscreen restrictions");

    reset();EnMd mido;mido.actor=actor(ACTOR_EN_MD);mido.actor.colChkInfo.mass=@MIDO_MASS@;
    mido.actor.home.pos={100,20,300};mido.collider.base.actor=&mido.actor;mido.actionFunc=EnMd_BlockPath;
    player.actor.world.pos={100,20,500};SoulInit(&mido.actor);
    bool update=true;SoulUpdate(&mido.actor,&update);if(update)EnMd_Update(&mido.actor,&state);
    CHECK(ocCalls==1&&mido.collider.dim.pos.x==100&&mido.collider.dim.pos.y==20&&mido.collider.dim.pos.z==300);
    CHECK(near(mido.actor.world.pos.x,100)&&near(mido.actor.world.pos.z,360)&&mido.actionFunc==EnMd_BlockPath);
    CHECK(player.talkActor==&mido.actor&&offerTextCalls==1&&canTalk(mido.actor));
    player.actor.colChkInfo.mass=MASS_HEAVY;Collider playerCollider;playerCollider.actor=&player.actor;playerCollider.ocFlags2=OC2_TYPE_PLAYER;
    ColliderInfo leftInfo,rightInfo;Vec3f left{},right{10,0,0};
    CollisionCheck_SetOCvsOC(&mido.collider.base,&leftInfo,&left,&playerCollider,&rightInfo,&right,5);
    CHECK(mido.actor.colChkInfo.displacement.x==0&&player.actor.colChkInfo.displacement.x==5);
    SoulUpdate(&mido.actor,&update);CHECK(focusAt(mido.actor,50));EnMd_Update(&mido.actor,&state);
    CHECK(ocCalls==2&&mido.collider.dim.pos.z==360);
    mido.interactInfo.talkState=NPC_TALK_STATE_ACTION;EnMd_BlockPath(&mido,&state);
    CHECK(mido.actionFunc==EnMd_Walk&&mido.waypoint==1&&mido.actor.speedXZ==1.5f&&eventFlags[EVENTCHKINF_SHOWED_MIDO_SWORD_SHIELD]);
    Actor_Draw(&state,&mido.actor);CHECK(modelCalls==0&&shadowCalls==0);
    souls[RAND_INF_NPC_SOUL]=true;Actor_Draw(&state,&mido.actor);CHECK(modelCalls==1&&shadowCalls==1);
    ++cases;std::puts("PASS actual Mido Update and BlockPath retain per-frame solid OC, positioning, talk, and quest-triggered path clearing while invisible");
    reset();state.sceneNum=SCENE_LOST_WOODS;mido=EnMd{};mido.actor=actor(ACTOR_EN_MD);
    mido.actor.home.pos=mido.actor.world.pos;mido.actionFunc=EnMd_BlockPath;player.actor.world.pos={100,20,500};
    SoulInit(&mido.actor);player.stateFlags2=PLAYER_STATE2_ATTEMPT_PLAY_FOR_ACTOR;EnMd_BlockPath(&mido,&state);
    CHECK(mido.actionFunc==EnMd_ListenToOcarina&&player.unk_6A8==&mido.actor&&ocarinaCalls==1&&
          (player.stateFlags2&PLAYER_STATE2_PLAY_FOR_ACTOR));
    mido.interactInfo.talkState=NPC_TALK_STATE_ACTION;EnMd_BlockPath(&mido,&state);
    CHECK(mido.actionFunc==EnMd_Walk&&eventFlags[EVENTCHKINF_PLAYED_SARIAS_SONG_FOR_MIDO_AS_ADULT]);
    ++cases;std::puts("PASS adult Lost Woods Mido still accepts the ocarina and clears his route on the existing quest action");
    std::printf("RESULT cases=%u assertions=%u\n",cases,assertions);
}
