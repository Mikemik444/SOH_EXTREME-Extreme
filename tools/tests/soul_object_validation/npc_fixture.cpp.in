static s16 Math_Vec3f_Yaw(Vec3f*a,Vec3f*b){return static_cast<s16>(std::atan2(b->x-a->x,b->z-a->z)*32768.0/3.14159265358979323846);}
static float Math_SinS(s16 a){return std::sin(a*3.14159265358979323846/32768.0);}
static float Math_CosS(s16 a){return std::cos(a*3.14159265358979323846/32768.0);}
static bool GameInteractor_Should(int event,bool original,...){return event==VB_MOVE_MIDO_IN_KOKIRI_FOREST&&moveMidoOverride?true:original;}
#define CHECK_QUEST_ITEM(...) quest
