static unsigned assertions=0,cases=0;
#define CHECK(c) do{++assertions;if(!(c)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#c);return 1;}}while(false)
static Actor actor(int id,int params=0,int category=ACTORCAT_NPC){
    Actor a;a.id=id;a.params=params;a.category=category;a.flags=ACTOR_FLAG_ATTENTION_ENABLED;
    a.world.pos={100,20,300};a.world.rot={1,200,3};a.draw=model;a.update=update;a.shape.shadowDraw=shadow;
    a.xzDistToPlayer=30;a.yawTowardsPlayer=0x4000;return a;
}
static void reset(){
    gNpcSoulInteractionFlags.clear();state=PlayState{};player=Player{};
    state.player=&player;state.sceneNum=SCENE_KOKIRI_FOREST;gPlayState=&state;
    for(int i=0;i<4;++i){options[i]=true;souls[i]=false;}
    isRando=true;modelCalls=shadowCalls=npcGlowCalls=enemyGlowCalls=renderOpenCalls=releaseCalls=0;
    geometryCalls=animationCalls=talkTrackingCalls=delayedLoads=actionCalls=0;
    npcGlow=offscreen=cutscene=gDbgCamEnabled=false;ocarinaCalls=chimeCalls=0;
    for(bool&flag:midoEvents){flag=false;}
    gSaveContext.linkAge=LINK_AGE_ADULT;
}
static bool near(float a,float b){return std::fabs(a-b)<0.001f;}
static bool canSpeak(Actor&a){player.talkActor=&a;bool should=true;SoulSpeak(&should);return should;}
static bool dynaQuery(Actor&a,int which){
    state.colCtx={};auto&d=state.colCtx.dyna;d.bgActors[0].actor=&a;d.bgActorFlags[0]=1;
    Vec3f pos{},end{1,10,1},out;CollisionPoly*poly=nullptr;int bg=50;float x=0,y=100,z=0,dist=100;
    if(which==0){DynaRaycast r;r.colCtx=&state.colCtx;r.pos=&pos;r.resultPoly=&poly;r.bgId=&bg;r.unk_20=BGCHECK_IGNORE_FLOOR;
        return BgCheck_RaycastFloorDyna(&r)!=BGCHECK_Y_MIN;}
    if(which==1)return BgCheck_SphVsDynaWall(&state.colCtx,0,&x,&z,&pos,10,&poly,&bg,nullptr);
    if(which==2)return BgCheck_CheckDynaCeiling(&state.colCtx,0,&y,&pos,50,&poly,&bg,nullptr);
    if(which==3)return BgCheck_CheckLineAgainstDyna(&state.colCtx,0,&pos,&end,&out,&poly,&dist,&bg,nullptr,0,0);
    return BgCheck_SphVsFirstDynaPoly(&state.colCtx,0,&poly,&bg,&pos,10,nullptr,0);
}
int main(){
    struct Placement{int id,params,scene;bool solid;};
    const Placement placements[]={
        {ACTOR_EN_KO,3,SCENE_KOKIRI_FOREST,true},{ACTOR_EN_KO,0x1203,SCENE_KOKIRI_FOREST,true},
        {ACTOR_EN_KO,3,SCENE_LOST_WOODS,false},{ACTOR_EN_KO,3,-1,false},
        {ACTOR_EN_MD,0,SCENE_KOKIRI_FOREST,false},{ACTOR_EN_MD,-1,SCENE_LOST_WOODS,true},
        {ACTOR_EN_MD,0,SCENE_MIDOS_HOUSE,false},{ACTOR_EN_MD,0,SCENE_HYRULE_CASTLE,false},
        {ACTOR_EN_KZ,0,0,false},{ACTOR_EN_HEISHI1,0,SCENE_HYRULE_CASTLE,false},
        {ACTOR_EN_HEISHI3,0,0,false},{ACTOR_EN_GE2,0,0,false},
        {ACTOR_EN_HEISHI2,2,0,false},{ACTOR_EN_HEISHI2,0x1205,0,false},
        {ACTOR_EN_GE1,0,0,false},{ACTOR_EN_GE1,1,0,false},{ACTOR_EN_GE1,0x1246,0,false},
        {ACTOR_EN_TA,0,SCENE_HYRULE_CASTLE,false},{ACTOR_EN_TA,-1,SCENE_HYRULE_CASTLE,false},
        {ACTOR_EN_RU1,0,0,false},{ACTOR_EN_KO,0,SCENE_KOKIRI_FOREST,false},
        {ACTOR_EN_KO,2,SCENE_KOKIRI_FOREST,false},{ACTOR_EN_KO,4,SCENE_KOKIRI_FOREST,false},
        {ACTOR_BG_ZG,0,0,false},{ACTOR_EN_JSJUTAN,0,0,false}};
    for(const auto&p:placements){
        reset();state.sceneNum=p.scene;Actor a=actor(p.id,p.params);
        a.flags|=ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED|ACTOR_FLAG_TALK;a.isTargeted=true;
        player.talkActor=player.focusActor=player.interactRangeActor=&a;player.getItemId=42;player.exchangeItemId=12;
        CHECK(MegaSoul_IsPathBlockingNpcPlacement(p.id,p.params,p.scene)==p.solid);
        CHECK(MegaSoul_ShouldDisableActorCollision(&a)==!p.solid&&!MegaSoul_CanInteractWithActor(&a));
        SoulInit(&a);CHECK(a.draw==model&&!(a.flags&(ACTOR_FLAG_ATTENTION_ENABLED|ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED|ACTOR_FLAG_TALK)));
        CHECK(!a.isTargeted&&player.talkActor==nullptr&&player.focusActor==nullptr&&player.interactRangeActor==nullptr);
        CHECK(player.getItemId==GI_NONE&&player.exchangeItemId==EXCH_ITEM_NONE&&releaseCalls==1);
        bool should=true;SoulUpdate(&a,&should);CHECK(should==p.solid&&!canSpeak(a));
        Actor_Draw(&state,&a);CHECK(modelCalls==0&&shadowCalls==0&&npcGlowCalls==0&&enemyGlowCalls==0&&renderOpenCalls==0);
        Collider c;c.actor=&a;CHECK(CollisionCheck_SetAT(&state,&state.colChkCtx,&c)==-1);
        CHECK(CollisionCheck_SetAC(&state,&state.colChkCtx,&c)==-1);
        CHECK((CollisionCheck_SetOC(&state,&state.colChkCtx,&c)>=0)==p.solid);
        for(int kind=0;kind<5;++kind){int before=geometryCalls;CHECK(dynaQuery(a,kind)==p.solid);CHECK((geometryCalls>before)==p.solid);}
        souls[RAND_INF_NPC_SOUL]=true;should=true;SoulUpdate(&a,&should);
        CHECK(should&&!MegaSoul_ShouldHideActor(&a)&&MegaSoul_CanInteractWithActor(&a));
        CHECK((a.flags&ACTOR_FLAG_ATTENTION_ENABLED)&&(a.flags&ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED));
        Actor_Draw(&state,&a);CHECK(modelCalls==1&&shadowCalls==1&&npcGlowCalls==1&&enemyGlowCalls==1&&renderOpenCalls==1);
        for(int kind=0;kind<5;++kind)CHECK(dynaQuery(a,kind));
        ++cases;
    }
    std::puts("PASS 25 NPC placements: only the Kokiri Forest exit boy and adult Lost Woods Mido retain collision; none can interact while hidden; existing actors restore on Soul acquisition");
    for(const auto&p:placements){
