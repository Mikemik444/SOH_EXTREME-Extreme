enum {ACTOR_FLAG_ATTENTION_ENABLED=1,ACTOR_FLAG_TALK=2,ACTOR_FLAG_IGNORE_POINTLIGHTS=4,ACTOR_FLAG_IGNORE_QUAKE=8};
enum {SCENE_KOKIRI_FOREST=0x55,SCENE_LOST_WOODS=0x5B,SCENE_HYRULE_CASTLE=0x5F};
enum {RSK_SHUFFLE_NPC_SOUL,RSK_SHUFFLE_SIGN_SOUL,RSK_SHUFFLE_ROCK_SOUL,RSK_SHUFFLE_CRATE_SOUL};
enum {RAND_INF_NPC_SOUL,RAND_INF_SIGN_SOUL,RAND_INF_ROCK_SOUL,RAND_INF_CRATE_SOUL};
enum {MASS_HEAVY=254,MASS_IMMOVABLE=255,MASSTYPE_NORMAL,MASSTYPE_HEAVY,MASSTYPE_IMMOVABLE};
enum {OC1_HIT=1,OC1_NO_PUSH=4,OC2_TYPE_PLAYER=1,OC2_HIT_PLAYER=2,OCELEM_HIT=1};
enum {NPC_TALK_STATE_IDLE,NPC_TALK_STATE_TALKING,NPC_TALK_STATE_ACTION};
enum {NPC_TRACKING_NONE,NPC_TRACKING_HEAD_AND_TORSO,NPC_TRACKING_FULL_BODY,CS_STATE_IDLE=0};
enum {VB_MOVE_MIDO_IN_KOKIRI_FOREST,VB_MIDO_CONSIDER_DEKU_TREE_DEAD,QUEST_KOKIRI_EMERALD,
      EVENTCHKINF_SPOKE_TO_MIDO_AFTER_DEKU_TREES_DEATH,EVENTCHKINF_SHOWED_MIDO_SWORD_SHIELD,
      EVENTCHKINF_PLAYED_SARIAS_SONG_FOR_MIDO_AS_ADULT,MSGMODE_PAUSED,OCARINA_ACTION_CHECK_SARIA,
      EXCH_ITEM_NONE=0,MTXMODE_APPLY=0};
enum {PLAYER_STATE2_ATTEMPT_PLAY_FOR_ACTOR=1,PLAYER_STATE2_PLAY_FOR_ACTOR=2,PLAYER_STATE2_NEAR_OCARINA_ACTOR=4};
#define SCREEN_WIDTH 320
