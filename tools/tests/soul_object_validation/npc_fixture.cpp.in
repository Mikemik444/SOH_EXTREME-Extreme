using s16=int16_t;using u16=uint16_t;using s32=int32_t;using u32=uint32_t;using u8=uint8_t;using f32=float;
struct Vec3f{float x=0,y=0,z=0;};struct Vec3s{int16_t x=0,y=0,z=0;};
struct PosRot{Vec3f pos;Vec3s rot;};
struct PlayState;struct Lights{};
struct Actor {
    int16_t id=0,params=0;int category=0,objBankIndex=0;uint32_t flags=0;
    PosRot world,home,focus;Vec3f scale{1,1,1};
    struct {Vec3s rot;float yOffset=0;void(*shadowDraw)(Actor*,Lights*,PlayState*)=nullptr;}shape;
    struct {u8 mass=0,damage=0,health=1;Vec3f displacement;}colChkInfo;
    void(*draw)(Actor*,PlayState*)=nullptr;
    float xzDistToPlayer=0,yDistToPlayer=0,speedXZ=0;
    s16 yawTowardsPlayer=0,colorFilterParams=0;u8 colorFilterTimer=0;bool isTargeted=false;u16 textId=0;
};
struct Player {Actor actor;Actor*talkActor=nullptr,*unk_6A8=nullptr;float talkActorDistance=10000;
               u32 exchangeItemId=0,stateFlags2=0;};
struct PlayState {
    int sceneNum=0,colChkCtx=0;Player*player=nullptr;
    struct {void*gfxCtx=nullptr;}state;
    struct {void*listHead=nullptr;}lightCtx;
    struct {Vec3f skyboxOffset;}mainCamera;
    struct {struct {void*segment=nullptr;}status[1];}objectCtx;
    struct {int msgMode=0;}msgCtx;
    struct {int state=0;}csCtx;
    struct {Vec3f eye;}view;
};
struct Collider{unsigned ocFlags1=0,ocFlags2=0;Actor*actor=nullptr,*oc=nullptr;};
struct ColliderInfo{unsigned ocElemFlags=0;};
struct ColliderCylinder{Collider base;struct {float radius=36;Vec3s pos;}dim;};
struct SkelAnime{void*animation=nullptr;float playSpeed=1;};
struct NpcInteractInfo{int16_t talkState=0;Vec3f trackPos;float yOffset=0;};
struct EnMd {Actor actor;ColliderCylinder collider;SkelAnime skelAnime;NpcInteractInfo interactInfo;
             void(*actionFunc)(EnMd*,PlayState*)=nullptr;int waypoint=0;s16 fidgetTableY[17]{},fidgetTableZ[17]{};};
using NpcGetTextIdFunc=u16(*)(PlayState*,Actor*);using NpcUpdateTalkStateFunc=s16(*)(PlayState*,Actor*);
using RandomizerInf=int;
@ACTOR_IDS@
