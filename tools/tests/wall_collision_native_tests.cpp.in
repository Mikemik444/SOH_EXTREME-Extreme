@BOMBCHU@

int cases=0, assertions=0;
void expect(bool result,const char* description) { ++assertions; if(!result) throw std::runtime_error(description); }
template<typename F> void test(const char* name,F body) {
    ++cases; try { body(); } catch(const std::exception& e) { throw std::runtime_error(std::string(name)+": "+e.what()); }
}
struct Scenario {
    PlayState play;
    BgBreakwall wall;
    Scenario(int type=BWALL_WALL,int mode=0,bool loaded=true,bool broken=false) {
        isRando=mode!=0; shuffledSouls=mode!=0; hasSouls=mode==2;
        enteredCavern=secondUpdate=frameAdvance=playIntroCutscene=false; forcedBreak=-1;
        drawCalls=deletedCollision=createdCollision=killedActors=switchWrites=fragments=entranceEvents=cutscenes=0;
        spawnedActorId=-1; bubbles=0; gSaveContext={}; matrix=identity(); matrixStack.clear();
        gPlayState=&play; play.objectCtx.loaded=loaded; play.switches[7]=broken;
        wall.dyna.actor.params=(type<<13)|7; wall.dyna.actor.update=BgBreakwall_Update;
        BgBreakwall_Init(&wall.dyna.actor,&play);
    }
    void clearRegistrations() { play.colChkCtx.colACCount=0; }
    void tick() {
        clearRegistrations();
        if(wall.dyna.actor.update && CapturedEngineSchedulesUpdate(&wall.dyna.actor))
            wall.dyna.actor.update(&wall.dyna.actor,&play);
    }
    bool contact(u32 mask) {
        // Physical contact is engine I/O. Registration and mask eligibility are
        // production code; a nonregistered or unsupported hit cannot be delivered.
        ColliderInfo attack; attack.toucher.dmgFlags=mask;
        bool registered=false;
        for(int i=0;i<play.colChkCtx.colACCount;++i)
            registered |= play.colChkCtx.colAC[i]==&wall.collider.base;
        if(!registered || CollisionCheck_NoSharedFlags(&attack,&wall.collider.info)) return false;
        wall.collider.base.acFlags |= AC_HIT; return true;
    }
};
bool same(const Vec3f& a,const Vec3f& b) {
    return std::abs(a.x-b.x)<0.0001f && std::abs(a.y-b.y)<0.0001f && std::abs(a.z-b.z)<0.0001f;
}

int main() {
    try {
        for(u32 attack:{nativeBombMask,D_80854488[4][0]}) test("old production update has no collider without Draw",[=] {
            Scenario s;
            Legacy::BgBreakwall_WaitForObject(&s.wall,&s.play);
            expect(createdCollision==1,"old solid wall exists");
            expect(!CapturedEngineSchedulesUpdate(&s.wall.dyna.actor),"old object-load step makes update depend on culling");
            Legacy::BgBreakwall_Update(&s.wall.dyna.actor,&s.play);
            expect(s.play.colChkCtx.colACCount==0 && !s.contact(attack),"actual old update cannot receive a valid attack without Draw");
            expect(s.wall.dyna.actor.update!=nullptr && switchWrites==0,"old solid wall stays unbroken");
            CapturedActorDrawTransform(&s.wall.dyna.actor,&s.play);
            Legacy::BgBreakwall_Draw(&s.wall.dyna.actor,&s.play);
            expect(s.play.colChkCtx.colACCount==1 && s.contact(attack),"old Draw supplies the missing collider");
            s.clearRegistrations(); Legacy::BgBreakwall_Update(&s.wall.dyna.actor,&s.play);
            expect(s.wall.dyna.actor.update==nullptr && switchWrites==1,"same native hit works once old Draw has registered it");
        });
        for(int mode:{0,1,2}) for(int type:{BWALL_DC_ENTRANCE,BWALL_WALL,BWALL_KD_FLOOR})
            for(u32 attack:{nativeBombMask,D_80854488[4][0]}) test("no-draw explosive/Hammer collision and break",[=] {
                Scenario s(type,mode); s.tick();
                expect(createdCollision==1 && drawCalls==0,"wall loads with no rendering");
                expect(CapturedEngineSchedulesUpdate(&s.wall.dyna.actor),"destructible wall continues updating outside draw volume");
                expect(s.play.colChkCtx.colACCount==1,"first loaded update registers exactly once");
                expect(s.wall.collider.info.bumper.dmgFlags==0x48,"vanilla attack mask preserved");
                expect((s.wall.collider.base.acFlags&(AC_TYPE_PLAYER|AC_TYPE_OTHER))==(AC_TYPE_PLAYER|AC_TYPE_OTHER),"native attack actor categories preserved");
                expect(MegaSoul_CanInteractWithActor(&s.wall.dyna.actor),"missing category Souls do not lock mud walls");
                expect(s.contact(attack),"registered wall accepts native attack mask");
                s.tick();
                expect(s.wall.dyna.actor.update==nullptr && killedActors==1,"previous hit consumed before registration can clear it");
                expect(s.play.switches[7] && switchWrites==1,"native wall switch written once");
                expect(deletedCollision==1 && fragments==1,"solid collision removed and break effects issued");
                expect(s.play.colChkCtx.colACCount==0,"destroyed wall never registers again");
                expect(entranceEvents==(type==BWALL_DC_ENTRANCE?1:0),"ordinary/floor breaks retain entrance-event distinction");
            });
        for(int mode:{0,1,2}) for(u32 attack:{D_80854488[0][0],D_80854488[4][1],u32(0x20)})
            test("unsupported native attacks remain rejected",[=] {
                Scenario s(BWALL_WALL,mode); s.tick();
                expect(!s.contact(attack),"sword/arrow/Hammer jumpslash is outside original0x48 mask");
                s.tick(); expect(s.wall.dyna.actor.update!=nullptr && !s.play.switches[7],"unsupported attack cannot destroy wall");
                expect(s.play.colChkCtx.colACCount==1 && deletedCollision==0,"solid receiving collider remains active");
            });
        test("Bomb Flower keeps native explosive attack",[] {
            Scenario s; s.tick(); expect(nativeBombflowerMask==nativeBombMask,"Bomb Flower explosion shares bomb damage bit");
            expect(s.contact(nativeBombflowerMask),"Bomb Flower contact accepted"); s.tick();
            expect(s.play.switches[7],"Bomb Flower breaks wall without Draw");
        });
        test("Bombchu uses actual bomb explosion handoff",[] {
            Scenario s; s.tick(); EnBomChu chu; chu.actor.world.pos={1,2,3}; chu.actor.speedXZ=5;
            EnBomChu_Explode(&chu,&s.play);
            expect(spawnedActorId==ACTOR_EN_BOM && spawnedBomb.timer==0,"actual Bombchu spawns immediate bomb explosion");
            expect(chu.timer==1 && chu.actor.speedXZ==0 && chu.actionFunc==EnBomChu_WaitForKill,"native Bombchu terminal state unchanged");
            expect(s.contact(nativeBombMask),"Bombchu bomb attack accepted"); s.tick(); expect(s.play.switches[7],"Bombchu explosion breaks wall");
        });
        test("object loading defers collision until ready",[] {
            Scenario s(BWALL_WALL,0,false); s.tick();
            expect(s.wall.actionFunc==BgBreakwall_WaitForObject && createdCollision==0 && s.play.colChkCtx.colACCount==0,"unloaded object has no invalid collider");
            expect(CapturedEngineSchedulesUpdate(&s.wall.dyna.actor),"object wait still updates offscreen");
            s.play.objectCtx.loaded=true; s.tick();
            expect(s.wall.actionFunc==BgBreakwall_Wait && createdCollision==1 && s.play.colChkCtx.colACCount==1,"ready object creates geometry and receiver in same update");
        });
        test("already broken wall remains absent",[] {
            Scenario s(BWALL_WALL,0,true,true);
            expect(s.wall.dyna.actor.update==nullptr && killedActors==1,"existing switch kills wall at init");
            expect(createdCollision==0 && s.play.colChkCtx.colACCount==0,"no solid or attack collision allocated");
        });
        test("missing object remains native init failure",[] {
            Scenario s; s.play.objectCtx.index=-1; s.wall.dyna.actor.update=BgBreakwall_Update;
            BgBreakwall_Init(&s.wall.dyna.actor,&s.play);
            expect(s.wall.dyna.actor.update==nullptr && s.play.colChkCtx.colACCount==0,"missing object kills actor without receiver");
        });
        test("rendering cannot duplicate registration or erase pending hit",[] {
            Scenario s; s.tick(); expect(s.contact(nativeBombMask),"valid hit queued");
            BgBreakwall_Draw(&s.wall.dyna.actor,&s.play); BgBreakwall_Draw(&s.wall.dyna.actor,&s.play);
            expect(drawCalls==2 && s.play.colChkCtx.colACCount==1,"multiple Draw calls are visual only");
            expect(s.wall.collider.base.acFlags&AC_HIT,"Draw cannot reset the pending attack");
            s.tick(); expect(s.play.switches[7] && deletedCollision==1,"pending hit still breaks next update");
        });
        test("native Blue Fire mask extension survives updates",[] {
            Scenario s; UpdateBlueFireCollidersBgBreakwall(&s.wall); s.tick();
            expect(s.wall.collider.info.bumper.dmgFlags==(0x48|DMG_ARROW_ICE),"update does not reset enhancement damage mask");
            s.tick(); expect(s.contact(DMG_ARROW_ICE),"enhancement attack still accepted");
            s.tick(); expect(s.play.switches[7],"enhanced attack retains break behavior");
        });
        for(int type:{BWALL_DC_ENTRANCE,BWALL_WALL,BWALL_KD_FLOOR}) for(int rotation:{0,0x4000,0x2100})
            test("new collider transform equals prior draw transform",[=] {
                Scenario s(type); s.tick();
                auto& actor=s.wall.dyna.actor;
                actor.world.pos={1200,-350,280}; actor.shape.rot={s16(rotation/2),s16(rotation),s16(-rotation/3)};
                actor.shape.yOffset=12; actor.scale={0.1f,0.2f,0.15f};
                CapturedActorDrawTransform(&actor,&s.play); Legacy::BgBreakwall_Draw(&actor,&s.play);
                std::array<Vec3f,4> previous;
                for(int i=0;i<4;++i) previous[i]=s.wall.collider.dim.quad[i];
                matrix=identity(); matrix[0][3]=9999; const auto before=matrix;
                s.clearRegistrations(); BgBreakwall_UpdateCollider(&s.wall,&s.play);
                for(int i=0;i<4;++i) expect(same(previous[i],s.wall.collider.dim.quad[i]),"world position, shape rotation, offset and scale preserved");
                expect(matrix==before && matrixStack.empty(),"collision transform restores global matrix stack");
                expect(s.play.colChkCtx.colACCount==1,"geometry refresh registers exactly once");
            });
        test("lava cover keeps native motion/culling and no attack collider",[] {
            Scenario s(BWALL_KD_LAVA_COVER); s.wall.dyna.actor.home.pos.y=100; s.tick();
            expect(s.wall.colType==-1 && s.wall.bombableWallDList==nullptr,"native lava collision-only subtype");
            expect(s.wall.actionFunc==BgBreakwall_LavaCoverMove && createdCollision==1,"native lava action and dynamic geometry selected");
            expect(!CapturedEngineSchedulesUpdate(&s.wall.dyna.actor),"lava retains original update culling behavior");
            const float before=s.wall.dyna.actor.world.pos.y;
            s.wall.dyna.actor.flags |= ACTOR_FLAG_INSIDE_CULLING_VOLUME; s.tick();
            expect(s.wall.dyna.actor.world.pos.y==before+1,"native one-unit lava movement preserved");
            BgBreakwall_Draw(&s.wall.dyna.actor,&s.play);
            expect(s.play.colChkCtx.colACCount==0 && drawCalls==0 && switchWrites==0,"lava gains no receiving collider, rendering or break switch");
        });
        for(bool enabled:{false,true}) test("entrance cutscene decision preserved",[=] {
            Scenario s(BWALL_DC_ENTRANCE); playIntroCutscene=enabled; s.tick(); s.contact(nativeBombMask); s.tick();
            expect(enteredCavern && entranceEvents==1,"native entrance event still written");
            expect(cutscenes==(enabled?1:0) && gSaveContext.cutsceneTrigger==(enabled?1:0),"existing cutscene hook decision honored");
        });
        test("vetoed break keeps collider for a later valid hit",[] {
            Scenario s; s.tick(); s.contact(nativeBombMask); forcedBreak=0; s.tick();
            expect(s.wall.dyna.actor.update!=nullptr && switchWrites==0 && s.play.colChkCtx.colACCount==1,"native hook veto does not remove wall or future hit detection");
            forcedBreak=-1; expect(s.contact(nativeBombMask),"later hit can be delivered"); s.tick();
            expect(s.play.switches[7],"normal behavior resumes after veto");
        });
        for(bool second:{false,true}) test("registration respects engine pause/extra-update guards",[=] {
            Scenario s; s.tick(); s.clearRegistrations();
            secondUpdate=second; frameAdvance=!second; BgBreakwall_Update(&s.wall.dyna.actor,&s.play);
            expect(s.play.colChkCtx.colACCount==0,"native SetAC guard is retained");
        });
        test("Soul gate fixture rejects actual locked categories",[] {
            Scenario s(BWALL_WALL,1); Actor other;
            other.id=ACTOR_EN_ISHI; expect(!MegaSoul_CanInteractWithActor(&other),"locked real rock still rejected");
            other.id=ACTOR_OBJ_KIBAKO; expect(!MegaSoul_CanInteractWithActor(&other),"locked crate still rejected");
            other.id=ACTOR_EN_MD; other.category=ACTORCAT_NPC;
            expect(!MegaSoul_CanInteractWithActor(&other),"locked real NPC still rejected");
            expect(MegaSoul_CanInteractWithActor(&s.wall.dyna.actor),"mud wall remains outside all those categories");
        });
        std::printf("BASELINE reproduced: old Update has zero AC registrations without Draw; valid attacks are ignored.\n");
        std::printf("RESULT cases=%d assertions=%d\n",cases,assertions);
    } catch(const std::exception& error) { std::fprintf(stderr,"%s\n",error.what()); return 1; }
    return 0;
}
