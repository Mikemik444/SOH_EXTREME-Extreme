    if (kind==VB_BG_BREAKWALL_BREAK && forcedBreak>=0) return forcedBreak!=0;
    if (kind==VB_PLAY_ENTRANCE_CS) return playIntroCutscene && defaultValue;
    return defaultValue!=0;
}
