using Matrix = std::array<std::array<float,4>,4>;
Matrix matrix;
std::vector<Matrix> matrixStack;
Matrix identity() { Matrix m{}; for (int i=0; i<4; ++i) m[i][i]=1; return m; }
Matrix multiply(const Matrix& a, const Matrix& b) {
    Matrix m{};
    for (int row=0; row<4; ++row) for (int col=0; col<4; ++col)
        for (int k=0; k<4; ++k) m[row][col] += a[row][k]*b[k][col];
    return m;
}
void Matrix_Push() { matrixStack.push_back(matrix); }
void Matrix_Pop() { assert(!matrixStack.empty()); matrix=matrixStack.back(); matrixStack.pop_back(); }
void Matrix_SetTranslateRotateYXZ(float x,float y,float z,Vec3s* rot) {
    const float rx=rot->x*3.14159265358979323846f/32768,
                ry=rot->y*3.14159265358979323846f/32768,
                rz=rot->z*3.14159265358979323846f/32768;
    Matrix mx=identity(),my=identity(),mz=identity();
    mx[1][1]=mx[2][2]=std::cos(rx); mx[1][2]=-std::sin(rx); mx[2][1]=std::sin(rx);
    my[0][0]=my[2][2]=std::cos(ry); my[0][2]=std::sin(ry); my[2][0]=-std::sin(ry);
    mz[0][0]=mz[1][1]=std::cos(rz); mz[0][1]=-std::sin(rz); mz[1][0]=std::sin(rz);
    matrix=multiply(multiply(my,mx),mz); matrix[0][3]=x; matrix[1][3]=y; matrix[2][3]=z;
}
void Matrix_Scale(float x,float y,float z,int) {
    for (int row=0;row<4;++row) { matrix[row][0]*=x; matrix[row][1]*=y; matrix[row][2]*=z; }
}
void Matrix_MultVec3f(Vec3f* src,Vec3f* dest) {
    *dest={matrix[0][0]*src->x+matrix[0][1]*src->y+matrix[0][2]*src->z+matrix[0][3],
           matrix[1][0]*src->x+matrix[1][1]*src->y+matrix[1][2]*src->z+matrix[1][3],
           matrix[2][0]*src->x+matrix[2][1]*src->y+matrix[2][2]*src->z+matrix[2][3]};
}
