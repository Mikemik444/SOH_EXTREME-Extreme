template<typename...T>void SkelAnime_InitFlex(T...){}
template<typename...T>void Animation_ChangeByInfo(T...){}
template<typename...T>void Collider_InitCylinder(T...){}
template<typename...T>void Collider_SetCylinder(T...){}
template<typename...T>void CollisionCheck_SetInfo2(T...){}
template<typename...T>void Actor_SetScale(T...){}
template<typename...T>Path* Path_GetByIndex(T...){return nullptr;}
template<typename...T>bool Flags_GetEventChkInf(T...){return false;}
static int ActorShadow_DrawCircle=0,gDogSkel=0,sAnimationInfo[8]={0},sCylinderInit=0,sColChkInfoInit=0;
static bool PlayerGrounded(Player*){return grounded;}
static void Math_ApproachF(float* x,float t,float,float step){*x+=std::clamp(t-*x,-step,step);}
static void Math_SmoothStepToS(s16* x,s16 t,int,int,int){*x=t;}
static void Actor_Kill(Actor* a){a->killed=true;}
static int Object_GetIndex(int*,int){return objectLoaded?0:-1;}
static void Player_GetRelativePosition(Player*,Vec3f* origin,Vec3f* off,Vec3f* result){
    result->x=origin->x+off->x;result->y=origin->y+off->y;result->z=origin->z+off->z;
}
static bool Flags_GetInfTable(int flag){return infFlags.contains(flag);}
static void Flags_SetInfTable(int flag){infFlags.insert(flag);++rewardCount;}
void EnDog_Wait(EnDog*,PlayState*){}
void EnDog_ChooseMovement(EnDog*,PlayState*){}
void EnDog_FollowPlayer(EnDog*,PlayState*);
void EnHy_Fidget(EnHy*,PlayState*){}
void EnHy_WaitDogFoundRewardGiven(EnHy*,PlayState*){}
void EnHy_GiveItem(EnHy*,PlayState*,int){++rewardCount;}
@ANIMAL_POLICY@
static void AnimalInitGate(Actor* actor,bool* result){
@ANIMAL_INIT_GATE@
}
@DOG@
static Actor* Actor_Spawn(int*,PlayState* play,int id,float x,float y,float z,int,s16 yaw,int,int params){
    ++spawnCount;if(spawnFails)return nullptr;
    spawnedDog={};spawnedDog.actor.id=id;spawnedDog.actor.params=params;
    spawnedDog.actor.world.pos={x,y,z};spawnedDog.actor.shape.rot.y=yaw;
    bool allowed=true;AnimalInitGate(&spawnedDog.actor,&allowed);
    if(!allowed)return nullptr;
    EnDog_Init(&spawnedDog.actor,play);return spawnedDog.actor.killed?nullptr:&spawnedDog.actor;
}
static void ArmTransfer(){
@ARM_TRANSFER@
}
static void Transfer(Player* self,PlayState* play){
    static Vec3f sDogSpawnOffset={0,0,-30},sDogSpawnPos;int dogParams;
@TRANSFER@
}
static u16 LadyText(EnHy* self,PlayState* play){
    switch(self->actor.params&0x7F){
@LADY_TEXT@
    }return 0;
}
@LADY_SPAWN@
static bool GameInteractor_Should(int behavior,bool initial,...){
    if(!randomizer)return initial;
    bool value=initial;bool* should=&value;
    va_list args;va_start(args,initial);
    switch(behavior){
@REWARD_HOOK@
    }
    va_end(args);return value;
}
static void LadyTalk(EnHy* self,PlayState* play){
    // Common actor/NPC-language dispatch is exercised by the separate NPC suite.
    switch(self->actor.textId){
@LADY_TALK@
    }
}
static void require(bool result,const char* message){
    ++assertions;if(!result){std::cerr<<"FAIL "<<message<<"\n";std::abort();}
}
static void reset(PlayState& p){
    ++cases;p={};p.sceneNum=SCENE_MARKET_NIGHT;gSaveContext={};gSaveContext.dogIsLost=true;
    day=adult=followEverywhere=allDogsRichard=spawnFails=false;objectLoaded=grounded=randomizer=true;
    animalMode=2;ownedFlags={RAND_INF_ANIMAL_SOUL_DOG};infFlags.clear();spawnCount=rewardCount=0;spawnedDog={};
}
static void initDog(EnDog& dog,PlayState& p,int raw){dog={};dog.actor.id=ACTOR_EN_DOG;dog.actor.params=raw;EnDog_Init(&dog.actor,&p);}
int main(){
    PlayState p;EnDog dog;EnHy lady;lady.actor.params=ENHY_TYPE_AOB;
    reset(p);initDog(dog,p,0);require(((dog.actor.params>>8)&15)==1,"Richard native identity normalized");
    dog.collider.base.ocFlags2=OC2_HIT_PLAYER;require(EnDog_CanFollow(&dog,&p)==1,"Richard starts following by contact");
    require(((gSaveContext.dogParams>>8)&15)==1,"Richard stored identity");
    for(int scene:{SCENE_BACK_ALLEY_NIGHT,SCENE_DOG_LADY_HOUSE}){
        ArmTransfer();require(gSaveContext.dogParams<0,"player init marks transferred dog");
        p.sceneNum=scene;Transfer(&p.player,&p);
        require(gSaveContext.dogParams==0x100&&spawnedDog.actionFunc==EnDog_FollowPlayer,"local scene preserves correct following dog");
        require(spawnedDog.actor.room==0,"ordinary local room ownership");
        spawnedDog.actor.xzDistToPlayer=60;EnDog_FollowPlayer(&spawnedDog,&p);
        require(gSaveContext.dogParams==0x100,"walking local route retains Richard");
    }
    require(spawnCount==2,"one follower spawned per local scene");
    require(EnHy_ShouldSpawn(&lady,&p),"lady exists at night");
    lady.actor.textId=LadyText(&lady,&p);require(lady.actor.textId==0x709F,"lady recognizes Richard");
    LadyTalk(&lady,&p);require(rewardCount==1&&infFlags.contains(INFTABLE_191),"native AP hook sets lost dog check once");
    require(gSaveContext.dogParams==0&&!gSaveContext.dogIsLost,"delivery consumes following dog state");
    require(lady.actionFunc==EnHy_Fidget&&LadyText(&lady,&p)==0x70A0,"completed dog reward state");

    reset(p);initDog(dog,p,0);p.sceneNum=SCENE_MARKET_DAY;day=true;dog.collider.base.ocFlags2=OC2_HIT_PLAYER;
    require(EnDog_CanFollow(&dog,&p)==0&&gSaveContext.dogParams==0,"day Richard cannot be retrieved");
    p.sceneNum=SCENE_DOG_LADY_HOUSE;require(!EnHy_ShouldSpawn(&lady,&p),"lady absent during day");
    reset(p);initDog(dog,p,0);dog.collider.base.acFlags=AC_HIT;dog.collider.base.ocFlags2=OC2_HIT_PLAYER;
    require(EnDog_CanFollow(&dog,&p)==2&&gSaveContext.dogParams==0,"hit dog does not immediately follow");
    reset(p);initDog(dog,p,0x100);dog.collider.base.ocFlags2=OC2_HIT_PLAYER;
    require(EnDog_CanFollow(&dog,&p)==1,"wrong dog can follow");p.sceneNum=SCENE_DOG_LADY_HOUSE;
    lady.actor.textId=LadyText(&lady,&p);require(lady.actor.textId==0x709E,"wrong dog rejected");LadyTalk(&lady,&p);
    require(gSaveContext.dogParams==0&&rewardCount==0,"wrong dog no AP check");
    reset(p);initDog(dog,p,0);gSaveContext.dogParams=0x200;dog.collider.base.ocFlags2=OC2_HIT_PLAYER;
    require(EnDog_CanFollow(&dog,&p)==0&&gSaveContext.dogParams==0x200,"second dog cannot replace active follower");
    reset(p);gSaveContext.dogParams=0x100;initDog(dog,p,0);require(dog.actor.killed,"return to market suppresses duplicate Richard");
    reset(p);p.sceneNum=SCENE_DOG_LADY_HOUSE;initDog(dog,p,0);require(dog.actor.killed,"house cannot supply a missing Richard");
    reset(p);p.sceneNum=SCENE_DOG_LADY_HOUSE;gSaveContext.dogIsLost=false;initDog(dog,p,0);
    require(!dog.actor.killed&&dog.actionFunc==EnDog_Wait,"returned Richard remains at home");
    reset(p);gSaveContext.dogParams=0x100;ArmTransfer();objectLoaded=false;Transfer(&p.player,&p);
    require(gSaveContext.dogParams==0&&spawnCount==0,"objectless shuffled scene loses dog without enhancement");
    reset(p);gSaveContext.dogParams=0x100;ArmTransfer();objectLoaded=false;followEverywhere=true;Transfer(&p.player,&p);
    require(gSaveContext.dogParams==0x100&&spawnedDog.actor.room==-1,"explicit follow everywhere supports other rooms");
    reset(p);gSaveContext.dogParams=0x100;dog.actor.xzDistToPlayer=450;EnDog_FollowPlayer(&dog,&p);
    require(gSaveContext.dogParams==0,"ordinary dog lost if player outruns it");
    reset(p);gSaveContext.dogParams=0x100;followEverywhere=true;dog.actor.xzDistToPlayer=450;EnDog_FollowPlayer(&dog,&p);
    require(gSaveContext.dogParams==0x100,"optional long follow unchanged");
    for(int mode:{0,1,2})for(bool exactSoul:{false,true})for(bool genericSoul:{false,true}){
        reset(p);animalMode=mode;ownedFlags.clear();if(exactSoul)ownedFlags.insert(RAND_INF_ANIMAL_SOUL_DOG);
        if(genericSoul)ownedFlags.insert(RAND_INF_ANIMAL_SOUL);
        Actor actor;actor.id=ACTOR_EN_DOG;bool allowed=true;
        AnimalInitGate(&actor,&allowed);require(allowed==(mode==0||(mode==1?genericSoul:exactSoul)),"dog soul mode matches actual init gate");
    }
    std::cout<<"PASS: Richard identity, local scene carry, native delivery flag, wrong/day dogs, soul modes and objectless scene limitation\n";
    std::cout<<"RESULT cases="<<cases<<" assertions="<<assertions<<"\n";
}
