using s8=int8_t;using u8=uint8_t;using s16=int16_t;using u16=uint16_t;using s32=int32_t;using f32=float;
using RandomizerInf=int;
struct Vec3f{float x=0,y=0,z=0;};struct Vec3s{s16 x=0,y=0,z=0;};
struct PlayState;struct EnDog;struct EnHy;
struct Actor{
    s16 params=0,id=0;int room=0,textId=0,flags=0,bgCheckFlags=0;
    bool killed=false;float speedXZ=0,gravity=0,xzDistToPlayer=0,xyzDistToPlayerSq=0,yDistToWater=0;
    s16 yawTowardsPlayer=0;
    struct{Vec3f pos;Vec3s rot;}world,shape;
    struct{int mass=0;}colChkInfo;
};
struct Player{Actor actor;};
struct PlayState{int sceneNum=0,objectCtx=0,actorCtx=0;Player player;};
struct ColliderCylinder{struct{int acFlags=0,ocFlags2=0;}base;};
struct Path{};struct SkelAnime{};
using EnDogActionFunc=void(*)(EnDog*,PlayState*);
struct EnDog{Actor actor;SkelAnime skelAnime;EnDogActionFunc actionFunc=nullptr;ColliderCylinder collider;
    Path* path=nullptr;int waypoint=0,nextBehavior=0;Vec3s jointTable[13],morphTable[13];};
using EnHyActionFunc=void(*)(EnHy*,PlayState*);
struct EnHy{Actor actor;unsigned talonEventChkInf=0;bool playedSfx=false;EnHyActionFunc actionFunc=nullptr;};
struct{s16 dogParams=0;bool dogIsLost=true;unsigned eventInf[4]={0};}gSaveContext;
static bool day=false,adult=false,objectLoaded=true,followEverywhere=false,allDogsRichard=false,grounded=true;
static bool randomizer=true,spawnFails=false;
static int animalMode=2,spawnCount=0,rewardCount=0,assertions=0,cases=0;
static std::set<int> ownedFlags,infFlags;
static EnDog spawnedDog;
@SYMBOLS@
@DOG_ENUMS@
@DOG_BEHAVIOR@
enum{AC_HIT=2,OC2_HIT_PLAYER=1,OBJECT_DOG=7,RSK_SHUFFLE_ANIMAL_SOUL=1,
    INFTABLE_CB=2,INFTABLE_191=3,GI_RUPEE_BLUE=4,GI_HEART_PIECE=5,
    EVENTCHKINF_ZELDA_FLED_HYRULE_CASTLE=6,EVENTCHKINF_PULLED_MASTER_SWORD_FROM_PEDESTAL=7,
    VB_GIVE_ITEM_FROM_LOST_DOG=8};
#define IS_DAY day
#define IS_NIGHT (!day)
#define LINK_IS_ADULT adult
#define LINK_IS_CHILD (!adult)
#define GET_PLAYER(p) (&(p)->player)
#define CVAR_ENHANCEMENT(x) x
struct Option{int value;int Get()const{return value;}operator bool()const{return value!=0;}};
#define RAND_GET_OPTION(x) Option{animalMode}
static bool MegaHas(int flag){return ownedFlags.contains(flag);}
static bool IsMegaAnimalActor(int id){return id==ACTOR_EN_DOG;}
static int CVarGetInteger(const char* key,int value){
    if(std::string(key)=="DogFollowsEverywhere")return followEverywhere;
    if(std::string(key)=="AllDogsRichard")return allDogsRichard;
    return value;
}
