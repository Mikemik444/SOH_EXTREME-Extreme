namespace EntranceTracker {
struct EntranceData { std::string source; int srcGroup; };
static std::map<int, EntranceData> grottoEntrances = {
    {ENTRANCE_GROTTO_EXIT_START + GROTTO_HF_NEAR_MARKET_OFFSET, {"HF Near Market Boulder Grotto", 12}},
    {ENTRANCE_GROTTO_EXIT_START + GROTTO_HF_SOUTHEAST_OFFSET, {"HF Southeast Grotto", 12}},
    {ENTRANCE_GROTTO_EXIT_START + GROTTO_HF_FAIRY_OFFSET, {"HF Fairy Grotto", 12}},
};
const EntranceData* GetEntranceData(int entrance) {
    const auto found = grottoEntrances.find(entrance);
    return found == grottoEntrances.end() ? nullptr : &found->second;
}
}
namespace Rando::StaticData {
struct Location {
    int scene;
    RandomizerCheckArea area;
    int GetScene() const { return scene; }
    RandomizerCheckArea GetArea() const { return area; }
};
static const std::map<RandomizerCheck, Location> locations = {
@LOCATION_INPUTS@
};
const Location* GetLocation(RandomizerCheck check) {
    const auto found = locations.find(check);
    return found == locations.end() ? nullptr : &found->second;
}
}
