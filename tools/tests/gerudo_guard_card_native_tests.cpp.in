enum { EVENTCHKINF_CARPENTERS_FREE_INDEX=9,EVENTCHKINF_CARPENTERS_FREE_MASK_ALL=15,
    SCENE_GERUDO_VALLEY=90,SCENE_GERUDOS_FORTRESS=93,GE1_LIMB_MAX=16,MASS_IMMOVABLE=255,
    ITEM_NONE=255,SLOT_BOW=1,ITEM_HOOKSHOT=2,ITEM_LONGSHOT=3,
    EVENTCHKINF_WATCHED_GANONS_CASTLE_COLLAPSE_CAUGHT_BY_GERUDO=4,
    ENTR_GERUDO_VALLEY_1=100,ENTR_GERUDOS_FORTRESS_18=101,ENTR_GERUDOS_FORTRESS_17=102,
    TRANS_TRIGGER_START=1,AC_HIT=2,NA_SE_SY_FOUND=3,NA_SE_VO_SK_CRASH=4,
    ACTOR_FLAG_ATTENTION_ENABLED=1,ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED=2,
    QUEST_GERUDO_CARD=22,VB_GERUDOS_BE_FRIENDLY=1,VB_GERUDO_GUARD_SET_ACTION_AFTER_TALK=2,
    ANIMMODE_ONCE=1,ANIMMODE_LOOP=2 };
