static void Math_SmoothStepToS(s16* x,s16 value,int,int,int) { *x=value; }
static void Message_CloseTextbox(PlayState* p) { ++closed; p->msgCtx.talkActor=nullptr;p->msgCtx.textId=0; }
static void Message_StartTextbox(PlayState* p,int id,Actor* a) { p->msgCtx.talkActor=a;p->msgCtx.textId=id; }
static void Player_SetCsActionWithHaltedActors(PlayState* p,Actor* a,int action) {
    p->player.csActor=a;p->player.csAction=action;if(action==7)++releases;
}
