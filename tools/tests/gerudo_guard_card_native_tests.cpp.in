static AnimationHeader gGerudoWhiteIdleAnim,gGerudoPurpleWalkingAnim,otherAnimation;
static AnimationHeader* sAnimations[9]={&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation,&otherAnimation};
