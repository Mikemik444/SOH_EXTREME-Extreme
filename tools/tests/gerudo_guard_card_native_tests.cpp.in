    Actor actor; ColliderCylinder collider; SkelAnime skelAnime;
    Vec3s jointTable[16], morphTable[16], headRot, unk_2A2;
    s16 eyeIndex=0,blinkTimer=0; u16 stateFlags=0; u8 hairstyle=0,cutsceneTimer=0;
    AnimationHeader* animation=nullptr; EnGe1ActionFunc actionFunc=nullptr; EnGe1AnimFunc animFunc=nullptr;
};
struct EnGe2 {
    Actor actor; ColliderCylinder collider; SkelAnime skelAnime;
    Vec3s jointTable[22],morphTable[22],headRot,unk_2EE;
    s16 eyeIndex=0,blinkTimer=0,walkDirection=0,yawTowardsPlayer=0;
    u16 stateFlags=0,walkDuration=0,walkTimer=0; float yDetectRange=0;
    u8 unk_304=0,timer=0,playerSpottedParam=0; EnGe2ActionFunc actionFunc=nullptr;
};
struct { unsigned eventChkInf[16]={0},eventInf[4]={0}; } gSaveContext;
static PlayState* gPlayState;
static bool isRando=true,card=false,isAdult=false,isDay=true,inventory=true,lineBlocked=false,talkClosing=false;
static int captures=0,closed=0,releases=0,transitions=0,colliders=0,talkOffers=0,koCalls=0;
static int assertions=0,cases=0;
#define IS_RANDO isRando
#define LINK_IS_ADULT isAdult
#define IS_DAY isDay
#define GET_PLAYER(p) (&(p)->player)
#define ABS(x) std::abs(x)
#define DECR(x) ((x) ? --(x) : 0)
#define CHECK_QUEST_ITEM(x) card
#define CHECK_FLAG_ALL(x,m) (((x)&(m))==(m))
#define INV_CONTENT(x) (inventory ? 1 : ITEM_NONE)
#define osSyncPrintf(...) ((void)0)
#define VT_FGCOL(x) ""
#define VT_RST ""
