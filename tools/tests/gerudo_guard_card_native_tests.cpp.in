struct Actor {
    int params=0, targetMode=0, textId=0, flags=1, colorFilterTimer=0;
    float uncullZoneForward=0, minVelocityY=0, gravity=0, speedXZ=0, xzDistToPlayer=0, yDistToPlayer=0;
    s16 yawTowardsPlayer=0;
    struct { Vec3s rot; } world, shape;
    struct { Vec3f pos; } focus;
    struct { int mass=0; } colChkInfo;
    Actor* parent=nullptr;
    void (*update)(Actor*, PlayState*)=nullptr;
};
struct Player { Actor* csActor=nullptr; int csAction=0; Vec3f bodyPartsPos[8]; };
struct PlayState {
    int sceneNum=93, colCtx=0, colChkCtx=0, transitionType=0, transitionTrigger=0, nextEntranceIndex=0;
    struct { Actor* talkActor=nullptr; int textId=0, choiceIndex=1; } msgCtx;
    Player player;
};
struct HitInfo { struct { unsigned dmgFlags=0; } toucher; };
struct ColliderCylinder {
    struct { unsigned acFlags=0; } base;
    struct { HitInfo* acHitInfo=nullptr; } info;
};
