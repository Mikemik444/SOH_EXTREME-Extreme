bool GameInteractor_Should(int behavior,bool vanilla,...) {
    if(!IS_RANDO)return vanilla;
    bool result=vanilla;bool* should=&result;
    va_list args;va_start(args,vanilla);
    switch(behavior) {
@HOOK_CASES@
    }
    va_end(args);return result;
}

@WHITE@
@PURPLE@

static void require(bool value,const std::string& label) {
    ++assertions;if(!value){std::cerr<<"FAIL "<<label<<"\n";std::abort();}
}
static void reset(PlayState& p) {
    ++cases;p=PlayState{};gPlayState=&p;
    isRando=true;card=false;isAdult=false;isDay=true;inventory=true;lineBlocked=false;talkClosing=false;
    captures=closed=releases=transitions=colliders=talkOffers=koCalls=0;
    for(auto& flags:gSaveContext.eventChkInf)flags=0;
    for(auto& flags:gSaveContext.eventInf)flags=0;
}
static void initWhite(EnGe1& a,PlayState& p,int type) {
    a={};a.actor.params=type;a.actor.xzDistToPlayer=20;a.actor.update=EnGe1_Update;EnGe1_Init(&a.actor,&p);
}
static void initPurple(EnGe2& a,PlayState& p,int type) {
    a={};a.actor.params=type;a.actor.xzDistToPlayer=20;a.actor.update=EnGe2_Update;EnGe2_Init(&a.actor,&p);
}
static void frame(Actor& a,PlayState& p,bool npcSoul=true) {
    // Existing MegaSouls hook dispatch is separately covered in the NPC suite.
    if(npcSoul&&a.update)a.update(&a,&p);
}
int main() {
    PlayState p;EnGe1 white;EnGe2 purple;
    const int whiteTypes[]={GE1_TYPE_GATE_OPERATOR,GE1_TYPE_NORMAL,GE1_TYPE_HORSEBACK_ARCHERY,GE1_TYPE_TRAINING_GROUND_GUARD};
    const EnGe1ActionFunc whiteFriendly[]={EnGe1_CheckGate_GateOp,EnGe1_SetNormalText,EnGe1_Wait_Archery,EnGe1_CheckForCard_GTGGuard};
    for(bool adult:{false,true})for(int n=0;n<4;++n) {
        reset(p);isAdult=adult;initWhite(white,p,whiteTypes[n]);
        frame(white.actor,p,false);require(captures==0,"frozen white guard");
        card=true;white.collider.base.acFlags=AC_HIT;frame(white.actor,p);
        require(captures==0&&transitions==0,"white card before restored first frame");
        require(white.actionFunc==whiteFriendly[n],"white correct normal role restored");
        require(white.collider.base.acFlags==0,"white stale hit cleared");
        frame(white.actor,p);require(captures==0,"white remains friendly");

        reset(p);isAdult=adult;initWhite(white,p,whiteTypes[n]);frame(white.actor,p);
        require(captures==1&&white.actionFunc==EnGe1_KickPlayer,"white without card still captures");
        const int before=captures;card=true;white.cutsceneTimer=0;frame(white.actor,p);
        require(captures==before&&transitions==0&&p.transitionTrigger==0,"white card cancels pending auto capture");
        require(closed==1&&releases==1&&p.player.csAction==7,"white own capture message and cutscene released");
        require(white.actionFunc==whiteFriendly[n],"white pending capture resumes role");

        reset(p);isAdult=adult;card=true;initWhite(white,p,whiteTypes[n]);
        require(white.actionFunc==whiteFriendly[n],"white card at init is friendly");
        frame(white.actor,p);require(captures==0,"white card init remains safe");
    }
    for(bool adult:{false,true})for(int type:{GE2_TYPE_PATROLLING,GE2_TYPE_STATIONARY}) {
        reset(p);isAdult=adult;initPurple(purple,p,type);frame(purple.actor,p,false);
        require(captures==0,"frozen purple guard");card=true;purple.collider.base.acFlags=AC_HIT;
        frame(purple.actor,p);require(captures==0&&transitions==0,"purple restored first frame safe");
        require(purple.actor.update==EnGe2_UpdateFriendly,"purple first frame switches update");
        require(purple.actor.targetMode==6&&purple.collider.base.acFlags==0,"purple normal targeting no stale hit");
        frame(purple.actor,p);require(captures==0,"purple remains friendly");

        reset(p);isAdult=adult;initPurple(purple,p,type);frame(purple.actor,p);
        require(captures>=1&&(purple.stateFlags&GE2_STATE_CAPTURING),"purple without card still captures");
        int before=captures;card=true;purple.actionFunc=EnGe2_CaptureClose;purple.timer=0;frame(purple.actor,p);
        require(captures==before&&transitions==0&&p.transitionTrigger==0,"purple card cancels imminent auto transition");
        require(closed==1&&releases==1&&p.player.csAction==7,"purple own capture released");
        require(!(purple.stateFlags&GE2_STATE_CAPTURING)&&purple.actor.update==EnGe2_UpdateFriendly,"purple capture state cleared");

        reset(p);isAdult=adult;card=true;initPurple(purple,p,type);frame(purple.actor,p);
        require(purple.actor.update==EnGe2_UpdateFriendly&&captures==0,"purple card at init safe");
    }
    // A different item textbox/cutscene must survive card cancellation.
    for(bool whiteGuard:{false,true}) {
        reset(p);Actor other;
        if(whiteGuard){initWhite(white,p,GE1_TYPE_NORMAL);frame(white.actor,p);}
        else{initPurple(purple,p,GE2_TYPE_PATROLLING);frame(purple.actor,p);}
        p.player.csActor=&other;p.player.csAction=42;p.msgCtx.talkActor=&other;p.msgCtx.textId=0x1234;card=true;
        if(whiteGuard)frame(white.actor,p);else frame(purple.actor,p);
        require(closed==0&&releases==0&&p.msgCtx.textId==0x1234&&p.player.csAction==42,"unrelated presentation preserved");
    }
    // Existing friendly dialogue/role state must not be reset on every frame.
    reset(p);initWhite(white,p,GE1_TYPE_HORSEBACK_ARCHERY);card=true;
    white.actionFunc=EnGe1_TalkAfterGame_Archery;white.cutsceneTimer=12;white.stateFlags=GE1_STATE_GIVE_QUIVER;
    frame(white.actor,p);require(white.actionFunc==EnGe1_TalkAfterGame_Archery&&white.cutsceneTimer==12&&
        white.stateFlags==GE1_STATE_GIVE_QUIVER,"existing archery result preserved");
    for(int type:{GE1_TYPE_GATE_GUARD,GE1_TYPE_VALLEY_FLOOR}) {
        reset(p);initWhite(white,p,type);auto action=white.actionFunc;card=true;frame(white.actor,p);
        require(white.actionFunc==action,"nonhostile white actor role unchanged");
    }
    // Knockout stays a knockout; hostile hookshot stun/recovery are unchanged.
    reset(p);initPurple(purple,p,GE2_TYPE_PATROLLING);purple.stateFlags|=GE2_STATE_KO;
    purple.actionFunc=EnGe2_KnockedOut;card=true;frame(purple.actor,p);
    require(koCalls==1&&(purple.stateFlags&GE2_STATE_KO)&&purple.actor.update==EnGe2_Update,"KO preserved after card");
    reset(p);initPurple(purple,p,GE2_TYPE_PATROLLING);HitInfo hookshot;hookshot.toucher.dmgFlags=0x80;
    purple.collider.info.acHitInfo=&hookshot;purple.collider.base.acFlags=AC_HIT;frame(purple.actor,p);
    require(purple.actor.update==EnGe2_UpdateStunned&&purple.actor.colorFilterTimer==400&&captures==0,"hostile hookshot stun");
    purple.collider.base.acFlags=0;purple.actor.colorFilterTimer=0;frame(purple.actor,p);
    require(purple.actor.update==EnGe2_Update,"hostile stun expiration");
    reset(p);initPurple(purple,p,GE2_TYPE_PATROLLING);purple.actor.update=EnGe2_UpdateStunned;
    purple.actor.colorFilterTimer=300;card=true;frame(purple.actor,p);
    require(purple.actor.update==EnGe2_UpdateFriendly&&purple.actor.colorFilterTimer==0&&captures==0,"existing card while stunned behavior");
    reset(p);initPurple(purple,p,GE2_TYPE_PATROLLING);purple.collider.base.acFlags=AC_HIT;frame(purple.actor,p);
    require((purple.stateFlags&GE2_STATE_KO)&&captures==0,"hostile nonhookshot hit still KO");

    // Deliberate jail request from a friendly patrol is not automatic sensing.
    reset(p);card=true;initPurple(purple,p,GE2_TYPE_PATROLLING);
    purple.actor.update=EnGe2_UpdateAfterTalk;purple.actionFunc=EnGe2_SetActionAfterTalk;
    talkClosing=true;p.msgCtx.choiceIndex=0;frame(purple.actor,p);
    require(captures==1&&(purple.stateFlags&GE2_STATE_CAPTURING)&&purple.actor.update==EnGe2_UpdateAfterTalk,"voluntary jail request retained");
    talkClosing=false;purple.actionFunc=EnGe2_CaptureClose;purple.timer=0;frame(purple.actor,p);
    require(transitions==1&&p.transitionTrigger==TRANS_TRIGGER_START,"voluntary jail transition retained");

    // New randomizer handling must not change vanilla hostility/friendliness.
    for(bool freed:{false,true}) {
        reset(p);isRando=false;card=true;gSaveContext.eventChkInf[EVENTCHKINF_CARPENTERS_FREE_INDEX]=freed?15:0;
        initWhite(white,p,GE1_TYPE_NORMAL);frame(white.actor,p);
        require((captures>0)==!freed,"vanilla white uses carpenters, not card");
        reset(p);isRando=false;card=true;gSaveContext.eventChkInf[EVENTCHKINF_CARPENTERS_FREE_INDEX]=freed?15:0;
        initPurple(purple,p,GE2_TYPE_PATROLLING);frame(purple.actor,p);
        require((captures>0)==!freed,"vanilla purple uses carpenters, not card");
    }
    reset(p);gSaveContext.eventChkInf[EVENTCHKINF_CARPENTERS_FREE_INDEX]=15;initPurple(purple,p,GE2_TYPE_PATROLLING);frame(purple.actor,p);
    require(captures>0,"randomizer freed carpenters without card still hostile");
    std::cout<<"PASS: live card receipt, first restored update, automatic capture cancellation, roles, KO/stuns, voluntary jail and vanilla behavior\n";
    std::cout<<"RESULT cases="<<cases<<" assertions="<<assertions<<"\n";
}
