void Alive() {}
f32 Math_SinS(s16 angle) { return std::sin(angle * (3.14159265358979323846f / 32768.0f)); }
f32 Math_CosS(s16 angle) { return std::cos(angle * (3.14159265358979323846f / 32768.0f)); }
void Math_Vec3f_Copy(Vec3f* out, const Vec3f* in) { *out = *in; }
s32 Math_StepToF(f32* value, f32 target, f32 step) {
    *value += std::clamp(target - *value, -step, step); return *value == target;
}
void Math_AsymStepToF(f32* value, f32 target, f32 up, f32 down) {
    Math_StepToF(value, target, *value < target ? up : down);
}
void Math_ScaledStepToS(s16* value, s16 target, s16 step) {
    const s16 diff = target - *value;
    *value += std::clamp<int>(diff, -step, step);
}
f32 GameInteractor_MovementSpeedMultiplier() { return 1.0f; }
bool GameInteractor_Should(int, bool original, ...) { return original; }
void LinkAnimation_Update(PlayState*, int*) {}
bool nativeFalling = false;
void func_80837B9C(Player*, PlayState*) { nativeFalling = true; }

// Every scene-geometry query is explicit IO, with an authored plane and
// controllable hazards; no synthetic coordinate is called a real asset proof.
struct Geometry {
    f32 floor = 0, waterHeight = 0;
    int bgId = BGCHECK_SCENE;
    bool missing = false, wall = false, ceiling = false, water = false, oc = false;
    int exit = 0, effect = 0, damage = 0, conveyor = 0, type = 0, property = 0;
    bool footprintGap = false, slope = false;
    Vec3f gapCenter;
    int floors = 0, walls = 0, ceilings = 0, waters = 0, ocs = 0;
} geo;
CollisionPoly floorPoly;
WaterBox waterBox;
f32 BgCheck_EntityRaycastFloor3(CollisionContext*, CollisionPoly** poly, s32* bgId, Vec3f* probe) {
    ++geo.floors;
    const f32 dx = probe->x - geo.gapCenter.x, dz = probe->z - geo.gapCenter.z;
    if (geo.missing || (geo.footprintGap && dx * dx + dz * dz < 9.0f) || probe->y < geo.floor) {
        *poly = nullptr; return BGCHECK_Y_MIN;
    }
    floorPoly.normal.y = geo.slope ? 20000 : 32767;
    *poly = &floorPoly; *bgId = geo.bgId; return geo.floor;
}
s32 BgCheck_EntitySphVsWall3(CollisionContext*, Vec3f* adjusted, Vec3f* next, Vec3f*,
                            f32 radius, CollisionPoly**, s32*, Actor*, f32 height) {
    ++geo.walls;
    if (radius != 14 && radius != 18) std::abort();
    if (height != 26) std::abort();
    *adjusted = *next; return geo.wall;
}
s32 BgCheck_EntityCheckCeiling(CollisionContext*, f32* outY, Vec3f*, f32 height,
                              CollisionPoly**, s32*, Actor*) {
    ++geo.ceilings; *outY = 0;
    if (height != 40 && height != 56) std::abort();
    return geo.ceiling;
}
s32 WaterBox_GetSurface1(PlayState*, CollisionContext*, f32, f32, f32* surface, WaterBox** box) {
    ++geo.waters; *surface = geo.waterHeight; *box = &waterBox; return geo.water;
}
u32 SurfaceType_GetSceneExitIndex(CollisionContext*, CollisionPoly*, s32) { return geo.exit; }
u32 SurfaceType_GetFloorEffect(CollisionContext*, CollisionPoly*, s32) { return geo.effect; }
u32 SurfaceType_IsWallDamage(CollisionContext*, CollisionPoly*, s32) { return geo.damage; }
u32 SurfaceType_GetConveyorSpeed(CollisionContext*, CollisionPoly*, s32) { return geo.conveyor; }
u32 SurfaceType_GetFloorType(CollisionContext*, CollisionPoly*, s32) { return geo.type; }
u32 func_80041EA4(CollisionContext*, CollisionPoly*, s32) { return geo.property; }
s32 CollisionCheck_LineOCCheck(PlayState*, CollisionCheckContext*, Vec3f*, Vec3f*, Actor** excluded, int count) {
    ++geo.ocs;
    if (count != 1 || excluded[0] != &player.actor) std::abort();
    return geo.oc;
}

