int assertions = 0, scenarios = 0;
void Check(bool value, const char* text, int line) {
    ++assertions;
    if (!value) { std::fprintf(stderr, "line %d: %s\n", line, text); std::exit(1); }
}
#define CHECK(value) Check((value), #value, __LINE__)
bool Close(f32 a, f32 b) { return std::fabs(a - b) < 0.01f; }
bool Same(const Vec3f& a, const Vec3f& b) { return Close(a.x,b.x) && Close(a.y,b.y) && Close(a.z,b.z); }
f32 Horizontal(const Vec3f& a, const Vec3f& b) { return std::hypot(a.x-b.x, a.z-b.z); }
Actor hole;
AgeProperties ages[2]{{18,56}, {14,40}};
void Prepare(int id = 14, int age = 1) {
    gPlayState = &playStorage;
    playStorage = {}; gSaveContext = {}; player = {}; hole = {}; geo = {};
    apActive = true; std::fill(std::begin(randomizerOptions), std::end(randomizerOptions), false);
    disableRockCollision = false; remembered = 0; trackedGrotto = -1; nativeFalling = false;
    registers[68] = -120; updateRate = 3;
    Grotto_InitExitAndLoadLists();
    grottoId = id; lastEntranceType = GROTTO_RETURN;
    gPlayState->sceneNum = grottoLoadTable[id].scene;
    gPlayState->roomCtx.curRoom.num = grottoReturnTable[id].room;
    gPlayState->colCtx.colHeader = &floorPoly;
    gPlayState->actorCtx.flags.tempSwch = 0x3456; gPlayState->actorCtx.flags.tempCollect = 0x789;
    gPlayState->actorCtx.actorLists[ACTORCAT_PLAYER].head = &player.actor;
    gPlayState->actorCtx.actorLists[ACTORCAT_PROP].head = &hole;
    gSaveContext.entranceIndex = grottoReturnTable[id].entranceIndex;
    gSaveContext.linkAge = age; gSaveContext.fileNum = 2;
    player.ageProperties = &ages[age]; player.actor.id = ACTOR_PLAYER;
    player.actor.world.pos = player.actor.home.pos = player.actor.prevPos = grottoReturnTable[id].pos;
    player.actor.shape.rot.y = player.yaw = grottoReturnTable[id].angle;
    player.actor.focus.pos = player.actor.world.pos; player.actor.focus.pos.y += 50;
    player.actor.update = Alive; player.actor.params = 0x04FF;
    hole.id = ACTOR_DOOR_ANA; hole.update = Alive; hole.world.pos = grottoReturnTable[id].pos;
    geo.floor = hole.world.pos.y;
    Grotto_SetupReturnInfo(grottoReturnTable[id], RESPAWN_MODE_DOWN);
    Grotto_SetupReturnInfo(grottoReturnTable[id], RESPAWN_MODE_RETURN);
}
void NativePlayerInitRespawn() {
    Player* link = &player; Actor* thisx = &player.actor; PlayState* play = gPlayState;
    s32 respawnFlag = 0, respawnMode = 0;
    @PLAYER_RESPAWN_OVERRIDE@
}

Vec3f ActualNativeNeutralLanding() {
    Player native = player;
    native.actor.velocity.y = 12; native.actor.gravity = 0; native.actor.minVelocityY = -20;
    native.linearVelocity = 0; native.actor.colChkInfo.displacement = {};
    nativeFalling = false;
    for (int frame = 0; frame < 64; ++frame) {
        native.actor.speedXZ = native.linearVelocity;
        native.actor.world.rot.y = native.yaw;
        Actor_MoveXZGravity(&native.actor);
        if (native.actor.velocity.y < 0 && native.actor.world.pos.y <= geo.floor) {
            native.actor.world.pos.y = geo.floor;
            return native.actor.world.pos;
        }
        native.actor.gravity = REG(68) / 100.0f;
        if (!nativeFalling) Player_Action_8084F9C0(&native, gPlayState);
        else { f32 speed = 0; s16 yaw = native.yaw; func_8083DFE0(&native, &speed, &yaw); }
    }
    CHECK(false); return {};
}

void AllAuthoredReturnsAndNativeMotion() {
    for (int id = 0; id < NUM_GROTTOS; ++id) for (int age = 0; age < 2; ++age) {
        ++scenarios; Prepare(id, age);
        const auto origin = player.actor.world.pos;
        const auto yaw = player.actor.shape.rot.y;
        const auto expected = ActualNativeNeutralLanding();
        CHECK(!Grotto_CanCaptureReturnPoint(&player.actor));
        CHECK(Grotto_QueueReturnLanding(&player.actor));
        CHECK(Grotto_HasPendingReturnLanding());
        CHECK(Grotto_ResolveReturnLanding(&player.actor) == 1);
        CHECK(Same(player.actor.world.pos, expected));
        CHECK(Horizontal(player.actor.world.pos, origin) > 15 + player.ageProperties->wallCheckRadius + 1);
        CHECK(player.actor.shape.rot.y == yaw);
        CHECK(Close((player.actor.world.pos.x-origin.x)*Math_CosS(yaw) -
                    (player.actor.world.pos.z-origin.z)*Math_SinS(yaw), 0));
        CHECK(Same(player.actor.home.pos, expected) && Same(player.actor.prevPos, expected));
        CHECK(Close(player.actor.focus.pos.y, expected.y + 50));
        CHECK(player.actor.floorPoly == &floorPoly && player.actor.floorBgId == BGCHECK_SCENE);
        CHECK(player.actor.bgCheckFlags & BGCHECKFLAG_GROUND);
        CHECK(player.actor.params == 0x0DFF && player.actor.speedXZ == 0 && player.linearVelocity == 0);
        CHECK(Same(player.actor.velocity, {}));
        CHECK(remembered == 1 && !Grotto_HasPendingReturnLanding());
        for (int mode : {RESPAWN_MODE_DOWN, RESPAWN_MODE_RETURN}) {
            CHECK(Same(gSaveContext.respawn[mode].pos, expected));
            CHECK(gSaveContext.respawn[mode].playerParams == 0x0DFF);
            CHECK(gSaveContext.respawn[mode].tempSwchFlags == 0x3456);
        }
        CHECK(geo.floors >= 10 && geo.walls > 10 && geo.ceilings > 10 && geo.waters >= 10 && geo.ocs == 9);
        Grotto_ForceGrottoReturn(); CHECK(Same(gSaveContext.respawn[1].pos, expected));
        Grotto_ForceRegularVoidOut(); CHECK(Same(gSaveContext.respawn[0].pos, expected));
        Grotto_ForceGrottoReturnOnSpecialEntrance(); CHECK(Same(gSaveContext.respawn[1].pos, expected));
        CHECK(gSaveContext.respawn[1].playerParams == 0x0DFF);
    }
}

void GeometryRejections() {
    for (int fault = 0; fault < 19; ++fault) {
        ++scenarios; Prepare();
        const auto expected = ActualNativeNeutralLanding();
        switch (fault) {
            case 0: geo.missing = true; break;
            case 1: geo.bgId = 2; break;
            case 2: geo.wall = true; break;
            case 3: geo.ceiling = true; break;
            case 4: geo.water = true; geo.waterHeight = geo.floor + 1; break;
            case 5: geo.oc = true; break;
            case 6: geo.exit = 1; break;
            case 7: geo.effect = 2; break;
            case 8: geo.damage = 1; break;
            case 9: geo.conveyor = 1; break;
            case 10: geo.type = 2; break;
            case 11: geo.type = 4; break;
            case 12: geo.property = 5; break;
            case 13: geo.slope = true; break;
            case 14: geo.floor -= 50; break;
            case 15: geo.footprintGap = true; geo.gapCenter = expected;
                geo.gapCenter.x += player.ageProperties->wallCheckRadius + 1; break;
            case 16: gPlayState->roomCtx.status = 1; break;
            case 17: gPlayState->colCtx.colHeader = nullptr; break;
            case 18: updateRate = 4; break;
        }
        CHECK(Grotto_QueueReturnLanding(&player.actor));
        CHECK(Grotto_ResolveReturnLanding(&player.actor) == 2);
        CHECK(Same(player.actor.world.pos, grottoReturnTable[14].pos));
        CHECK(!grottoLanding.landed && grottoLanding.observing && remembered == 0);
        Grotto_ForceGrottoReturn(); CHECK(gSaveContext.respawn[1].playerParams == 0x04FF);
        Grotto_ForceRegularVoidOut(); CHECK(gSaveContext.respawn[0].playerParams == 0x04FF);
    }
    for (int bad : {3,7,12}) {
        ++scenarios; Prepare(); geo.type = bad;
        CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor) == 2);
    }
    ++scenarios; Prepare(); geo.property = 12;
    CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor) == 2);
}

void ActorAndHoleExclusions() {
    for (int fault = 0; fault < 7; ++fault) {
        ++scenarios; Prepare(); const auto destination = ActualNativeNeutralLanding();
        ObjBombiwa boulder; EnIshi rock; Actor other;
        Actor* actor = fault == 0 ? &boulder.actor : fault == 1 ? &rock.actor : &other;
        actor->world.pos = destination; actor->update = Alive;
        actor->id = fault == 0 ? ACTOR_OBJ_BOMBIWA : fault == 1 ? ACTOR_EN_ISHI : ACTOR_OTHER;
        if (fault < 2) {
            ColliderCylinder& collider = fault == 0 ? boulder.collider : rock.collider;
            collider.dim.pos = {(s16)destination.x,(s16)destination.y,(s16)destination.z};
            collider.dim.height = 70; collider.dim.radius = 55;
        } else if (fault == 2) actor->init = Alive;
        else if (fault == 3) { actor->colChkInfo.cylRadius=20; actor->colChkInfo.cylHeight=60; }
        else if (fault == 4) { actor->colChkInfo.cylRadius=1; actor->colChkInfo.cylHeight=60;
            actor->colChkInfo.mass=MASS_IMMOVABLE; actor->world.pos.x+=50; }
        else if (fault == 5) actor->id = ACTOR_DOOR_ANA;
        else actor->colChkInfo.mass = MASS_IMMOVABLE; // Mido: real OC, zero generic dimensions
        hole.next = actor;
        CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor) == 2);
        if (fault == 1) {
            // The existing Soul policy disables ordinary rock collision; the
            // placement helper consumes that policy instead of inventing one.
            disableRockCollision = true;
            CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor) == 1);
        }
        if (fault == 0) {
            disableRockCollision = true;
            CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor) == 2);
        }
    }
}

void ObserveFallbackAndInvalidate() {
    ++scenarios; Prepare(); const auto destination = ActualNativeNeutralLanding();
    geo.wall=true; CHECK(Grotto_QueueReturnLanding(&player.actor));
    CHECK(Grotto_ResolveReturnLanding(&player.actor)==2); geo.wall=false;
    player.actor.bgCheckFlags=BGCHECKFLAG_GROUND;
    Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==0); // hole is not a checkpoint
    player.actor.world.pos=destination;
    player.actor.bgCheckFlags=0; Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==0);
    player.actor.bgCheckFlags=BGCHECKFLAG_GROUND; player.actor.floorBgId=3;
    Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==0);
    player.actor.floorBgId=BGCHECK_SCENE; player.stateFlags1=PLAYER_STATE1_IN_WATER;
    Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==0);
    player.stateFlags1=PLAYER_STATE1_FLOOR_DISABLED;
    Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==0);
    player.stateFlags1=0; Grotto_UpdateReturnLanding(&player.actor);
    CHECK(remembered==1 && grottoLanding.landed && !Grotto_HasPendingReturnLanding());
    Grotto_UpdateReturnLanding(&player.actor); CHECK(remembered==1);
    CHECK(Same(gSaveContext.respawn[1].pos,destination));
    for (int field = 0; field < 7; ++field) {
        ++scenarios; Prepare(); CHECK(Grotto_QueueReturnLanding(&player.actor));
        switch(field) {
            case 0: ++gSaveContext.fileNum; break;
            case 1: gSaveContext.linkAge ^= 1; break;
            case 2: ++gPlayState->sceneNum; break;
            case 3: ++gPlayState->roomCtx.curRoom.num; break;
            case 4: ++gSaveContext.entranceIndex; break;
            case 5: ++grottoId; break;
            case 6: apActive=false; break;
        }
        CHECK(!Grotto_HasPendingReturnLanding()); CHECK(Grotto_ResolveReturnLanding(&player.actor)==0);
        CHECK(!grottoLanding.queued && !grottoLanding.landed && remembered==0);
    }
    ++scenarios; Prepare(); CHECK(Grotto_QueueReturnLanding(&player.actor)); Grotto_InitExitAndLoadLists();
    CHECK(!Grotto_HasPendingReturnLanding());
    ++scenarios; Prepare(); CHECK(Grotto_QueueReturnLanding(&player.actor));
    Grotto_OverrideSpecialEntrance(ENTRANCE_GROTTO_EXIT_START+1); CHECK(!grottoLanding.queued);
    ++scenarios; Prepare(); CHECK(Grotto_QueueReturnLanding(&player.actor));
    CHECK(Grotto_ResolveReturnLanding(&player.actor)==1);
    overridingNextEntrance=false; gSaveContext.respawnFlag=0; Grotto_SanitizeEntranceType();
    CHECK(!grottoLanding.landed && lastEntranceType==NOT_GROTTO);
}

void InteriorAndVanillaAndLegacy() {
    ++scenarios; Prepare();
    const int native = Grotto_OverrideSpecialEntrance(1806);
    CHECK(native==1432 && trackedGrotto==14 && lastResolvedTarget==1806 && lastResolvedNative==1432);
    CHECK((u8)gSaveContext.respawn[1].data==229);
    gPlayState->sceneNum=SCENE_GROTTOS; gPlayState->roomCtx.curRoom.num=0;
    CHECK(SCENE_GROTTOS==62 && !Grotto_QueueReturnLanding(&player.actor));
    ++scenarios; Prepare(); apActive=false;
    CHECK(!Grotto_QueueReturnLanding(&player.actor));
    randomizerOptions[RSK_SHUFFLE_GROTTO_ENTRANCES]=true;
    Grotto_ForceGrottoReturnOnSpecialEntrance(); CHECK(gSaveContext.respawn[1].playerParams==0x04FF);
    Grotto_ForceGrottoReturn(); CHECK(gSaveContext.respawn[1].playerParams==0x0DFF);
    ++scenarios; Prepare();
    gSaveContext.fw.playerParams=0x04FF; gSaveContext.respawn[2].pos=grottoReturnTable[14].pos;
    Grotto_SetupReturnInfoOnFWReturn(); CHECK(gSaveContext.respawn[1].playerParams==0x04FF);
    // The original helper idles at precisely the authored hole even when an
    // earlier ActorEntry stage already selected a perfectly good landing.
    for (int id=0; id<NUM_GROTTOS; ++id) {
        ++scenarios; Prepare(id); const auto landing=ActualNativeNeutralLanding();
        player.actor.world.pos=landing;
        Legacy_Grotto_ForceGrottoReturn(); NativePlayerInitRespawn();
        CHECK(Same(player.actor.world.pos,grottoReturnTable[id].pos));
        CHECK(player.actor.params==0x0DFF && !Grotto_CanCaptureReturnPoint(&player.actor));
        Prepare(id); player.actor.world.pos=landing;
        Grotto_ForceGrottoReturn(); NativePlayerInitRespawn();
        CHECK(player.actor.params==0x04FF);
        CHECK(Grotto_QueueReturnLanding(&player.actor)); CHECK(Grotto_ResolveReturnLanding(&player.actor)==1);
        CHECK(Same(player.actor.world.pos,landing));
    }
}

int main() {
