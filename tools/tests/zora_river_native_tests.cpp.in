#define DEFINE_ENTRANCE(id, scene, spawn, continueBgm, titleCard, startType, endType) \
    {scene, spawn, ENTRANCE_INFO_FIELD(continueBgm, titleCard, endType, startType)},
#include "entrance_table.h"
