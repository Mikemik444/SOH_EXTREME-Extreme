void CaptureSceneDeparture(bool physicalCrossing) {
    REQUIRE(physicalCrossing);
    ++capturedPhysicalDepartures;
}
#include "captured_runtime_methods.inc"
}
#include "captured_runtime_exports.inc"
s16 Grotto_OverrideSpecialEntrance(s16 target) {
    // All cases use native destinations. The full grotto handler's IO is
    // irrelevant here, but its real resolved-arrival callback still executes.
    REQUIRE(target >= 0 && target < ENTR_MAX);
    ++nativeResolutionCalls;
    return Archipelago_ResolvedEntranceArrival(target, target);
}
