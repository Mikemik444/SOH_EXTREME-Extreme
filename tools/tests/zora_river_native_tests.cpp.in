int assertionCount = 0;
std::string currentCase;
std::map<std::string, int> caseCounts;
void Check(bool passed, const char* expression, int line) {
    ++assertionCount;
    if (!passed) {
        std::cerr << currentCase << ':' << line << ": " << expression << '\n';
        std::exit(1);
    }
}
#define REQUIRE(expression) Check(static_cast<bool>(expression), #expression, __LINE__)
void StartCase(const std::string& category, const std::string& detail = "") {
    ++caseCounts[category];
    currentCase = category + (detail.empty() ? "" : "/" + detail);
}

enum { GAMEMODE_NORMAL = 0, GAMEOVER_INACTIVE = 0 };
struct PlayState {
    int sceneNum = SCENE_HYRULE_FIELD;
    struct { int state = GAMEOVER_INACTIVE; } gameOverCtx;
} play, *gPlayState = &play;
struct SaveContext {
    int health = 48;
    int gameMode = GAMEMODE_NORMAL;
    int respawnFlag = 0;
} gSaveContext;
bool currentSaveIsAP = true;
bool child = true;
#define LINK_IS_CHILD child
bool Archipelago_IsCurrentSaveFile() { return currentSaveIsAP; }
int capturedPhysicalDepartures = 0;
int nativeResolutionCalls = 0;
std::set<u16> discovered;
s16 lastEntrance = -1;
std::array<int, RSK_MAX> optionValues{};
std::array<EntranceOverride, ENTRANCE_OVERRIDES_MAX_COUNT> overrideRows{};
u8 Randomizer_GetSettingValue(RandomizerSettingKey key) { return optionValues[key]; }
EntranceOverride* Randomizer_GetEntranceOverrides() { return overrideRows.data(); }
void Grotto_InitExitAndLoadLists() {}
void Grotto_SetExitOverride(s16, s16) { throw std::runtime_error("Unexpected grotto exit in river fixture"); }
void Grotto_SetLoadOverride(s16, s16) { throw std::runtime_error("Unexpected grotto entry in river fixture"); }
void Entrance_SetEntranceDiscovered(u16 entrance, u8 reversed) {
    REQUIRE(!reversed);
    discovered.insert(entrance);
}
u8 Entrance_GetIsEntranceDiscovered(u16 entrance) { return discovered.contains(entrance); }
void EntranceTracker_SetLastEntranceOverride(s16 entrance) { lastEntrance = entrance; }

