const EntranceEndpoint* lastArrivalTarget=nullptr;
CrossingJournal doorJournal;
bool suppressTransitionChecks=false, dungeonReturnArrival=false;
// Scene-history storage and arrival-safety validation are covered by the
// full-runtime return/arrival suites; no alternate routing is modeled here.
void ArmArrival(int,int) {}
void CaptureSceneDeparture(bool=false) {}
uint8_t CurrentArrivalAge() { return child ? kEntranceChildAge : kEntranceAdultAge; }
void AdvanceDoor() {}
