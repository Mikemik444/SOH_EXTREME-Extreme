SohExtreme::CrossingJournal gCrossingJournal;
class ArchipelagoClient {
  public:
    bool currentSaveIsArchipelago=true, sessionActive=true;
    std::set<int64_t> active, submitted;
    std::vector<int64_t> sent;
    static ArchipelagoClient& GetInstance() { static ArchipelagoClient instance; return instance; }
    bool IsGameplaySessionActive() const { return sessionActive && currentSaveIsArchipelago; }
    bool IsLocationActive(int64_t id) const { return active.contains(id); }
    bool IsLocationSubmitted(int64_t id) const { return submitted.contains(id); }
    void SendLocation(int64_t id,bool) { submitted.insert(id); sent.push_back(id); }
    bool HasSceneTransitionChecks() const;
    void ReportTransition(int64_t);
    void BeginWarpSongTransition(int);
    void CaptureSceneTransition();
    void CompleteSceneTransition(int16_t);
    void AdvanceDoorTransition();
};
