bool Archipelago_EntranceShuffleActive() { return currentSave && SohExtreme::EntranceRuntime::routing.Active(); }
void Archipelago_RecordEntrance(int source) { SohExtreme::EntranceRuntime::Record(source); }
void Entrance_SetEntranceDiscovered(int,bool) {}
void EntranceTracker_SetLastEntranceOverride(int source) { nativeLookups.push_back(source); }
// Grotto/room actor arrival is an engine boundary. Use the real reviewed base
// and resulting respawn mode so the song journal sees post-resolution data.
s16 Grotto_OverrideSpecialEntrance(s16 target) {
    const auto* policy=SohExtreme::EntranceDestinationById(target);
    if (!policy) return target;
    if (policy->kind==SohExtreme::kEntranceGrottoReturn) {
        gSaveContext.respawnFlag=2;
        gSaveContext.respawn[RESPAWN_MODE_RETURN].playerParams=0x4FF;
    } else if (policy->kind==SohExtreme::kEntranceRoomDoor) {
        gSaveContext.respawnFlag=0;
    }
    return policy->nativeIndex;
}
void Grotto_ForceGrottoReturnOnSpecialEntrance() {}
