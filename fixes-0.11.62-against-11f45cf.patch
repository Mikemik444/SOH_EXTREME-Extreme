+    target=out/(name+'.bin')
+    proc=subprocess.run([str(exe),command,str(source),str(other),str(target)],capture_output=True,text=True)
+    assert proc.returncode==(0 if success else 1),(name,proc.returncode,proc.stdout,proc.stderr)
